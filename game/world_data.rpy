    def descendants_depth(nodes, node):
        indexed = {n['id']: n for n in nodes}
        level = 0
        parent = node.get('parent')
        while parent in indexed:
            level += 1
            parent = indexed[parent].get('parent')
        return level

    def group_assets(group):
        return [a for a in ASSET_CATALOG if a['group'] == group]

    def navigate_gallery(group):
        renpy.show_screen('gallery', initial_category=group)
