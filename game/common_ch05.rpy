# 原创正文；第 5 日为小雨，不是角色线第 12 日的大雨。
default ch5_station = ""
default ch5_notice = ""
default ch5_kept_seat = False

label common_ch05:
    $ ch5_station = ""
    $ ch5_notice = ""
    $ ch5_kept_seat = False
    call ch05_scene1
    call ch05_scene2
    call ch05_scene3
    call ch05_scene4
    call ch05_scene5
    $ persistent.main_common_ch05_seen = True
    return

label ch05_scene1:
    $ chapter = "第五章 / 01 · 晒到一半的晴天"
    scene bg echo morning with dissolve
    show sprite glm as glm at sprite_breathe(0.72) with dissolve
    "庭院里排着四盆花。GLM拿着一根竹尺，把最外侧那盆向左挪了半寸。"
    "盆底在石板上留下圆圆的湿印。她退回廊下看一眼，又将花盆搬回原处。"
    l_you "刚才那个位置不好？"
    l_glm "好。但这里的人路过，会先看见我。"
    l_you "你不是在挑花的位置？"
    l_glm "花和摊主，当然一起挑。"
    "她给第四盆系上浅色纸牌，纸上没有价钱，画着一只端小盆的手。"
    l_glm "祭典后可以认领。今天先让我摆漂亮。"
    "一滴水落在纸牌上，将刚写好的末笔晕开。她抬头，第二滴正落在鼻尖。"
    scene bg echo rain with dissolve
    show sprite glm as glm at sprite_breathe(0.72)
    show sprite minimax as minimax at sprite_breathe(0.28) with dissolve
    $ minimax_pose = "neutral"
    l_minimax "先别收，我刚好拍到你抬头。"
    l_glm "拍到我皱脸了？那一段不能用。"
    l_minimax "只留花。脸等你点头再放。"
    "MiniMax把镜头盖扣回去，伸手接了接屋檐外的雨。掌心只有几个浅浅的水点。"
    l_minimax "真下了。下午的影子全没了。"
    l_you "昨天不是说傍晚才下？"
    "她将气象告示翻到背面。旧时间下面新贴了一条纸，预计午前起有间歇小雨。"
    l_minimax "早上改的。我的拍摄表没来得及追上。"
    l_glm "我的花也没追上。你先扶这盆，叶子会勾。"
    "你和她将花盆移到廊口。MiniMax没拿相机，空出两只手接住最沉的一盆。"
    "叶片扫过她的额发，她歪着脑袋避开，仍没松手。"
    l_minimax "一会儿谁说我只会指挥，请替我作证。"
    l_glm "先别作证。你搬的是我那盆最轻的。"
    "廊柱另一头传来椅脚擦地的响声。Grok将夜市折桌拖进来，桌边还挂着一个红色号码牌。"
    hide glm
    show sprite grok as grok at sprite_breathe(0.72) with dissolve
    l_grok "让条路。十八号摊位，提前入夜。"
    l_you "你这招牌是不是太容易看错？"
    l_grok "看错了先坐，坐下了再看菜单。"
    "她把牌翻过来，背面清清楚楚写着十八岁以上。旁边的小字提醒酒类只在晚间出售。"
    l_grok "白天只卖热饮。别拿我的摊子当借口。"
    l_minimax "廊口今天要排练，你的桌子占机位。"
    l_grok "我的桌子上有刚淋到雨的人。你拍桌脚？"
    "桌后果然跟着两位提纸灯的镇民。他们将湿伞收拢，灯罩仍护在外衣下面。"
    "Grok拿干巾给他们擦手，自己的肩头却滴着水。MiniMax看看相机包，往里退了一步。"
    l_minimax "我改机位。别让人站在檐外等。"
    hide minimax
    show sprite qwen as qwen at sprite_breathe(0.28) with dissolve
    l_qw "排练改到廊下，厨房领物改走侧门。"
    "Qwen抱来的告示边角卷着。上面原有的箭头指向庭院，正被她用纸条一条条盖住。"
    l_qw "雨不会替我们认路。先把箭头改对。"
    "你接过她手里的浆糊。廊口只余一条能走人的空隙，正对着昨天留下的那盏公共备用灯。"
    "灯下的空位没有被桌子堵住。Grok用脚把一把椅子再勾近些，让抱灯的人可以坐下。"
    return

label ch05_scene2:
    $ chapter = "第五章 / 02 · 留在哪一头"
    scene bg echo rain with dissolve
    show sprite grok as grok at sprite_breathe(0.72) with dissolve
    show sprite minimax as minimax at sprite_breathe(0.28) with dissolve
    "桌子进廊后，雨仍不大。屋檐的水线却正滴在排练入口，走过的人都要侧身绕一下。"
    "Grok用空托盘接水，MiniMax在地上比画脚步。两个人同时向你递来一件东西。"
    l_grok "帮我看热饮。杯子端稳，笑话随意。"
    l_minimax "我缺一个走位的人。笑话可以带过来。"
    l_you "我长了两只手，但只有一双脚。"
    l_grok "那先借一双。下半场会还你。"
    "Qwen在另一头招手，GLM已经把花摆到告示旁。有人需要留下，而不是四处应声。"
    menu:
        "留在排练与热饮这头。":
            $ ch5_station = "rehearsal"
            $ main_bond('minimax')
            l_you "我留这里。来回跑反而挡路。"
            l_minimax "好，先当一盏会走路的灯。"
            l_grok "有茶钱吗？这盏灯看着挺贵。"
            "MiniMax把一只空灯框塞给你，要你从柱后走到桌前。你刚迈步，Grok便端着托盘拦住去路。"
            l_grok "观众可不会等你的镜头。"
            "你抱灯往右避，差点碰到坐着的人。MiniMax放下手里的分镜纸，在石板上贴了两个布记号。"
            l_minimax "这次靠柱走。人先过，你再出。"
            "第二回你沿柱绕行，桌前自然空出一段。她蹲下看了眼高度，把相机位置也放低。"
            l_you "你原来的大场面呢？"
            l_minimax "等晴天再拍。今天先拍端稳一杯茶。"
            "Grok在你手里的空灯框底部垫了块干布，叫你暂时拿它当送杯子的篮子。"
            l_grok "道具借用有了。你现在是流动茶灯。"
            "一位镇民点了无糖热茶，你差点从甜茶壶里倒。Grok握住壶柄，先把两个盖子交换位置。"
            l_grok "我标得太像。下回看这个黑绳结。"
            "她没把出错的杯子交给客人，自己加了水喝掉，又让你试端一只半满的。"
            l_minimax "刚才那个动作不错。可以拍你的手吗？"
            l_grok "手可以，狼狈的脸算加价。"
            "镜头最后只收进黑绳结、冒热气的杯口，以及给行人让开的那半步。"
            l_you "你不是想拍她递杯子时的脸？"
            l_minimax "想。但她没点头，我留下一次。"
        "留在告示与花盆这头。":
            $ ch5_station = "notices"
            $ main_bond('glm')
            hide grok
            hide minimax
            show sprite qwen as qwen at sprite_breathe(0.28) with dissolve
            show sprite glm as glm at sprite_breathe(0.72) with dissolve
            l_you "我留入口，先让大家走得进来。"
            l_glm "那你站这边。不要踩我的展示线。"
            "所谓展示线是一根绑在花盆上的棉绳。她原想圈出认领区，现在绳子横在行人脚前。"
            l_qw "花的位置很好，绳的位置请再想想。"
            "GLM将棉绳收回掌心，绕上廊柱，改成一条可以挂小牌的细线。"
            l_glm "这样也行。抬头就能看到。"
            l_you "人抬头了，花在脚边。"
            "她低头看你，再看看花，终于将最矮的那盆放在废木箱上。"
            l_glm "你负责发现问题，我负责装作早就知道。"
            "Qwen已经写完新箭头。你举着它从两条小路分别走来，发现从石阶那面只能看到纸背。"
            l_qw "给我。背面也写，不多做一张。"
            l_you "你原来的茶水时间表被压住了。"
            l_qw "我看见了。所以这张要再往上挪。"
            "她没有把自己的茶席划掉，只将第二轮推迟一刻钟，让出领灯的人流。"
            "GLM在花牌上补了几滴画出来的雨，用很小的字注明祭后认领，不保证附送摊主。"
            l_you "有人问过附送吗？"
            l_glm "还没有。先让他们有这个想法。"
            "一位镇民伸手指向花，你照牌子说明。对方问要不要现在付款，GLM立刻摇头。"
            l_glm "今天只登记。花得等我摆完祭典。"
            "她替对方写下可联系的摊位，没有索取住址。Qwen看了看，给她留出一块压纸的木片。"
            "雨丝斜着钻进廊口，你扶住告示。GLM拿自己的小披巾遮住纸角，先护住刚写下的名字。"
    "这头的事情刚顺了些，另一头便传来杯盘轻碰的响声。你抬眼看过去，没有立即松开手里的东西。"
    "Grok隔着人群举了举手，示意没事。MiniMax也举起拇指，让你留在原位。"
    "雨把大家挤到了同一条长廊，却没有让任何人多长出一双手。"
    return

label ch05_scene3:
    $ chapter = "第五章 / 03 · 取消后面的两个字"
    scene bg echo rain with dissolve
    show sprite qwen as qwen at sprite_breathe(0.72) with dissolve
    "午前，有人拿着旧告示来找Qwen。上面的庭院排练四个字被水泡开，时间倒还清楚。"
    "对方只看见入口新增的取消二字，以为整个祭典都不办了，准备回去通知邻居。"
    l_qw "庭院场取消，廊下场照常。后半句太小。"
    "她把纸摘下来，指腹染上一点尚未干透的黑墨。刚写好的箭头又得取下。"
    l_you "要不要写得醒目些？"
    l_qw "醒目得先让人看懂。你从路口念一遍。"
    "你站到石阶顶。伞沿遮住上半张纸，只剩一个大大的雨字。"
    l_you "我现在只能知道今天有雨。"
    l_qw "这件事大家已经亲自知道了。"
    show sprite glm as glm at sprite_breathe(0.28) with dissolve
    "GLM抱来两块空花牌，背面还粘着一点泥。她用布擦净，放在Qwen手边。"
    l_glm "我的牌子短，写不下绕口的话。"
    l_you "那就把最需要知道的写在前面。"
    menu:
        "先写新的地点和时间。":
            $ ch5_notice = "time"
            l_you "廊下，一点半。后面再解释原因。"
            "Qwen先写地点，再写时间。你将两块牌挂成上下排列，远处也能看见数字。"
            l_qw "旧纸保留在旁边，加一道移至这里。"
            l_glm "箭头朝我？那我得站得好看一点。"
            "你们让拿旧告示的人试走一遍。对方从石阶读完第一行，直接来到廊下等候。"
            l_you "这次没走错。"
            l_qw "也没有问雨要下多久。很好。"
            "GLM在时间旁添了一朵小花，随即把花改小，免得挡住末尾的半字。"
            l_glm "我的认领说明放下面。今天先借大家一眼。"
        "先画一条能走通的路线。":
            $ ch5_notice = "map"
            l_you "画石阶、花盆和廊柱，沿着它走。"
            "Qwen画了三笔就停下来。她画的花盆像茶杯，你在旁边添了两片叶。"
            l_glm "这盆是谁的？长得有点着急。"
            l_you "你的抽象版本。认得出位置就行。"
            "你们请拿旧告示的人照图走。对方到了花盆旁，第一眼却没找到画里的红带子。"
            "GLM立刻把红带子从自己腕上解下，系到廊柱外侧。"
            l_glm "这回真的有了。别把我也画进去。"
            l_qw "时间仍要写。路线不能告诉人几点来。"
            "她将一点半写在图下，又注明台阶湿滑。你用手挡着细雨，等墨迹干透再挂上。"
    if ch5_notice == "time":
        "GLM又解下腕上的红带，系到最外侧的廊柱上，让找到时间牌的人也能认准入口。"
    "第一张新告示挂好后，Qwen没有马上去写第二张。她把三个人沾墨的手放在一处看。"
    l_qw "有件很实际的事。谁现在能碰白杯子？"
    l_glm "我可以只碰杯底。"
    l_qw "刚才你摸过花盆底。"
    "你们轮流洗手。Grok送来三杯热饮，杯套上分别画了笔、花和一双脚。"
    l_you "我怎么只剩一双脚？"
    l_grok "刚才不是你说只能借一双？到期归还。"
    "Qwen端起有笔的那杯，却把自己的茶席牌拿回眼前，重新量了量剩下的空地。"
    l_qw "一点半排练，三点我开茶。不要临时再延。"
    l_you "这次你没把自己的安排挪走。"
    l_qw "茶已经泡了一轮。我也想坐下好好喝。"
    "GLM伸手按住被风掀起的纸。她的红带子垂在柱边，每逢有人走对路，就轻轻晃一下。"
    return

label ch05_scene4:
    $ chapter = "第五章 / 04 · 没有阳光的那一条"
    scene bg echo rain with dissolve
    show sprite minimax as minimax at sprite_breathe(0.72) with dissolve
    $ minimax_pose = "neutral"
    "一点二十分，MiniMax把相机放在低架上。廊外没有她等了一上午的阳光，只有一片亮灰色。"
    "她原先的分镜纸上，一束金色光线穿过纸灯。现在那一页被压在包底，露出一个折角。"
    l_you "新的第一镜拍什么？"
    l_minimax "人进来，放伞，接灯。你看着像不像排队？"
    l_you "本来就是排队。"
    l_minimax "我知道。可我想留点别的。"
    "她抬起相机又放下，听了一会儿屋檐的水声。Grok正在试三把折椅，第三把每坐下便吱一声。"
    show sprite grok as grok at sprite_breathe(0.28) with dissolve
    l_grok "这把自带伴奏。谁坐谁独唱。"
    l_minimax "先别修，让我收一声。"
    l_grok "我不替椅子签出场同意书。"
    "MiniMax笑起来，终于把包底那张分镜抽出，翻到空白的一面。"
    l_minimax "从椅子开场。然后接花牌，再接茶。"
    l_you "灯呢？"
    l_minimax "灯最后进来。有人坐下，灯才有地方去。"
    "她把麦克风夹到屋檐内侧，耳机里立刻响起很密的一阵敲击。你以为雨变大了，往外看却仍是细雨。"
    l_minimax "不是雨，是托盘。水滴在盘底。"
    "Grok拿起接水盘，声音消失了，水却直接滴在她鞋尖。她低头看了看，慢慢抬眼。"
    l_grok "你的好声音，价格是我一双鞋。"
    l_minimax "先放回去。我挪麦克风。"
    "MiniMax将夹子移到柱后，绕开盘子的回响。你试着在桌前说了一句话，她没听清，示意再近一点。"
    l_you "热茶在这边，小心脚下。"
    l_grok "真诚得像我的生意已经做了三十年。"
    "她也试说同一句，尾音故意拖长，惹得桌旁的人发笑。MiniMax摘下一只耳机，指向杯子。"
    l_minimax "平时怎么说就怎么说，不用替话筒表演。"
    "Grok端起杯，伸到你面前，声音突然轻了下来。"
    l_grok "热的，先别急。"
    "这次MiniMax没有打断。回放里有雨滴、有椅脚，最清楚的是杯子递到人手中时那四个字。"
    l_you "这一条留下？"
    l_minimax "问她。我的手已经按在保存键上了。"
    "Grok点头，顺手把自己的湿鞋挪到桌底。你递来干布，她用鞋尖接住，没有让镜头再等。"
    "排练开始，几个领灯的人按地上的布记号前进。廊下不宽，纸灯稍稍一抬就碰到横梁。"
    "Grok扶住最前面那只灯框，让人从椅后绕过去。她自己站在檐边，被挤得只剩半只鞋在干处。"
    if ch5_station == "rehearsal":
        "你沿刚才试过的柱边路线走，空灯框里放着两杯水。MiniMax向你示意，镜头随着杯口的热气落下。"
        l_minimax "对，就照上午那一步。给后面留位置。"
        "你将杯子交给Grok，顺手把接水的托盘向外挪。她终于能把两只脚都收回廊内。"
        l_grok "流动茶灯，今天加一片柠檬。"
        l_you "能换成椅子吗？"
        l_grok "等拍完。我的独唱椅留给你。"
    else:
        "入口有人停下看图，你沿着花盆外侧迎过去，指给对方看柱边的路。"
        l_glm "红带子这边。认领花的往后一点。"
        "两股人流终于分开。Qwen从告示旁向你点点头，把原本举着的指路牌放回桌上。"
        l_qw "现在它能自己工作了。你歇一会儿。"
        "你刚退回廊内，GLM便将矮花盆转了半圈，把没被雨打坏的一面朝向镜头。"
        l_glm "路我让了，这一镜得给花。"
    "排到第三次，一位镇民忘了下一步，抬着灯停在原地。后面的人跟着停下，都望向镜头。"
    l_minimax "可以停。先把手放低，别酸着。"
    "她按了暂停，没有喊人重来。Grok把椅子推过去，对方一坐下，那声熟悉的吱响便冒了出来。"
    "大家先是一愣，随后有人笑出了声。最前面的人笑弯了腰，纸灯上的花也跟着晃。"
    l_minimax "刚才这段，愿意留吗？不愿意我就删。"
    "被拍到的人看完回放，指了指自己歪着的灯，又笑着点头。"
    "MiniMax另存下获准的片段，把未获同意的旁人从画面边缘裁掉。"
    l_you "你刚才一直想要的，是这个？"
    l_minimax "不是我原来想的那个。但我喜欢这个。"
    "她指尖停在播放键上，没有立刻开始下一遍。那张画着金光的旧分镜仍夹在包侧。"
    l_minimax "晴天那条我还会拍。给自己留着。"
    "Grok坐进会响的椅子，端起自己的茶。声音果然再次响起，她若无其事地冲镜头抬了抬杯。"
    l_grok "我的脸这次可以。别加奇怪的字幕。"
    "拍完后，她向MiniMax要了那一小段的回放，自己看完，又倒回递杯子的地方。"
    l_grok "这儿留慢一点。那个人手冷，接杯子时在抖。"
    l_minimax "好。我把前面的停顿也留下。"
    "Grok没有再挑自己的表情，放下屏幕去添热水。MiniMax把那张晴天分镜收好，第一次没急着赶下一镜。"
    return

label ch05_scene5:
    $ chapter = "第五章 / 05 · 给晴天留的座位"
    scene bg echo with dissolve
    show sprite qwen as qwen at sprite_breathe(0.28) with dissolve
    show sprite glm as glm at sprite_breathe(0.72) with dissolve
    "傍晚只余零星的雨。Qwen按时收了茶壶，最后两杯却没急着倒掉，留给还在搬花的人。"
    "GLM的认领纸添了三个名字。有一个人只写了常去的摊位，约定祭后再来挑盆。"
    l_glm "我今天还以为一盆也没人看。"
    l_qw "看花的人不少。看你手腕的人也有。"
    "GLM低头找自己的红带子，才想起它仍在廊柱上替人指路。"
    l_glm "借它站了一天。明天它得回我这里。"
    if ch5_notice == "time":
        "你将时间牌取下来，发现有人在背面补了一行三点茶席。Qwen认出自己的字，伸手将纸抚平。"
        l_qw "有人看完排练真的来坐了。没有问我要延期。"
        l_you "大字的位置起作用了。"
        l_qw "明天仍这样写。我也想按时喝完第二杯。"
    else:
        "一个迟来的镇民照着小地图走进廊下，先看红带子，再问认领花是不是在这里。"
        l_glm "是这里。图上的怪花也是我的。"
        "你把地图留在入口，只替换掉已经结束的排练时间。纸上的三片叶子已经被很多人指得发亮。"
        l_qw "这张留到祭典。明天不用重新试路。"
    "Grok来还空杯，身后跟着抱相机的MiniMax。四个人各占长桌一角，桌上终于没有待领的纸灯。"
    hide qwen
    hide glm
    show sprite grok as grok at sprite_breathe(0.28) with dissolve
    show sprite minimax as minimax at sprite_breathe(0.72) with dissolve
    l_grok "今天赚了九杯热饮的钱，赔上一条干毛巾。"
    l_minimax "还有一把会唱歌的椅子。"
    l_grok "那个留着。有人点它出场。"
    "她把那把椅子推到你身旁。你坐下时它没有响，她不甘心地用鞋尖碰了一下椅脚。"
    l_grok "下班得还挺快。"
    l_you "也许只跟你唱。"
    "MiniMax把回放放在桌中央。花牌、杯沿、走慢的脚步依次过去，末尾是Grok那个没有字幕的举杯。"
    l_minimax "最后还差一个空镜。你们谁都别动。"
    "所有人一齐停住。她却将镜头转向桌边那把空椅，椅背后是雨后刚亮起来的庭院。"
    l_grok "你让我们不动，只拍空椅？"
    l_minimax "怕你们把它坐了。这个位置我想留给晴天。"
    "GLM从镜头外伸来手，把一盆花放到椅旁。Qwen也将一只杯垫推进去，刚好没挡住光。"
    l_you "这下晴天得早点来，否则没地方坐。"
    $ ch5_kept_seat = True
    "檐下一阵饭香。DeepSeek端着两只盖碗，绕开刚收好的线缆，把其中一只放到相机包旁。"
    hide minimax
    show sprite deepseek offer_rice as deepseek at sprite_breathe(0.72) with dissolve
    $ deepseek_expression = "offer_rice"
    l_ds "你们还要拍饭吗？我只能等三十下。"
    l_grok "拍完能多一碗？"
    l_ds "那可以等六十下。"
    "你揭开碗盖，米饭上压着一块煎得微焦的豆腐。她的那碗更高，豆腐却只有半块。"
    l_you "怎么分成这样？"
    l_ds "试咸淡。结果挺好，试得有点多。"
    "Qwen从旁边递来小碟，把余下半块放到她碗边。DeepSeek看了一眼，筷子没有立刻伸过去。"
    l_ds "先给搬花的人。今天那盆看着真沉。"
    "GLM接了小碟，却把一角切给MiniMax。镜头已经盖好，没有人再要求把这一口演一遍。"
    "你们在长桌旁吃完饭。空椅一直留到收工，明天的告示压在椅面，字迹已经干透。"
    "七日晚的点灯安排还没写上谁的名字。纸上留着足够大的空处，等明天各自开口。"
    return
