# v0.9 GPT 第八章独立正文候选；未总装、未原生验收。
# 全员成年30岁；沿实际五场 call／本章 seen／return 结构。
# 只新增 gpt8_ 存档变量。结局收藏、计数、卡片与保存由 root 外层 runner 负责。
# 本章没有真实新CG，使用现有背景与立绘，不注册或解锁计划素材。

default persistent.main_gpt_ch08_seen = False
default gpt8_activity = ""
default gpt8_reply = ""
default gpt8_reply_confirmed = False
default gpt8_ending = ""
default gpt8_complete = False

label gpt_ch08:
    $ gpt8_activity = ""
    $ gpt8_reply = ""
    $ gpt8_reply_confirmed = False
    $ gpt8_ending = ""
    $ gpt8_complete = False
    if gpt7_reply in ("love", "wait", "friend"):
        $ gpt8_reply = gpt7_reply
        $ gpt8_reply_confirmed = True
    call gpt08_scene1
    call gpt08_scene2
    call gpt08_scene3
    call gpt08_scene4
    call gpt08_scene5
    $ gpt8_ending = gpt8_reply
    $ gpt8_complete = True
    $ persistent.main_gpt_ch08_seen = True
    return

label gpt08_scene1:
    $ chapter = "GPT 第八章 / 01 · 桌子先空出来"
    scene bg echo morning with dissolve
    show sprite gpt as gpt at sprite_breathe(0.64) with dissolve
    if gpt8_reply == "love":
        "第十五日上午，你推开茶屋的门，GPT已经在靠窗的小桌旁。她将两只杯垫分开，见你进来，先把你的那张椅子拉出来。"
        l_gpt "今天水壶放在另一边。不会再撞到你。"
        l_you "我还没有伸手。"
        l_gpt "先处理一项已经发生过的事故。其余的，等你坐下。"
    elif gpt8_reply == "wait":
        "第十五日午后，你来茶屋问她今天是否方便试茶。GPT正将写生用的笔包放到窗旁，听见你才转过身。"
        l_gpt "现在有空。傍晚我想自己去河口画一会儿。"
        l_you "那我先坐一小会儿。"
        l_gpt "嗯。你来喝茶，不用替我取消晚上的打算。"
    elif gpt8_reply == "friend":
        "第十五日，茶屋的小窗开着。你来试昨天说起的苦茶，GPT从架上取来两只小杯，没有往整壶里放茶。"
        l_gpt "先一小杯。你那条建议，我没有忘。"
        l_you "茶还没喝，至少省下半壶水。"
        l_gpt "别这么快宣布省钱。我还想试另一种。"
    else:
        "第十五日的茶屋还很安静。GPT看见你停在门旁，将画桌边的一张椅子拉到窗前，空出能坐的位置。"
        l_gpt "要坐一会儿吗？今天有一种新茶。"
        l_you "会很苦？"
        l_gpt "我也还没试。先别相信我摆杯子的熟练程度。"
    "你坐下时，膝前没有画袋。GPT将私人袋留在自己的椅旁，另一侧的干燥箱仍靠墙，没被搬来充当茶桌。"
    if gpt6_shared_sign_done and gpt6_mark == "river":
        "公共取画说明平放在干套外层。那条拐歪的河仍有木夹浅印，旧署名与箭头没有改成今天的茶单。"
        l_you "这条河今天不引人来喝茶？"
        l_gpt "不用。一张纸不必同时替我接完所有来客。"
    elif gpt6_shared_sign_done and gpt6_mark == "dragon":
        "干套外层仍夹着那张取画说明。长短不一的角与长脚留在原处，龙旁的小椅子也没有被擦掉。"
        l_gpt "纸里那位今天歇着。我们坐真的。"
        l_you "真的这一张，腿有地方放。"
    else:
        "墙边只有今天收好的空画套和另夹的标签纸。她扶正纸夹，将空套往里推一点，先递来自己的茶杯。"
        l_gpt "杯子在这里。那边先不用看。"
    "你尝了一口，停了片刻。GPT看着你的眉头，原本准备介绍茶叶的那句话到了嘴边，换成了一声笑。"
    l_gpt "不好喝就说。别替这张桌子维持好名声。"
    l_you "第一口有点苦。再等一会儿。"
    "她也尝了一口，脸上的从容立刻收窄一点。两个人对着杯底看了看，谁也没有急着把剩下的茶倒给对方。"
    l_gpt "我想续一点热水。不是给你的答案加水。"
    l_you "我也要。给茶加就好。"
    return

label gpt08_scene2:
    $ chapter = "GPT 第八章 / 02 · 一人做一件"
    scene bg echo morning with dissolve
    show sprite gpt as gpt at sprite_breathe(0.63) with dissolve
    "热水添过，小杯终于能慢慢喝完。GPT将杯底的水痕擦掉，望向窗下尚未归架的空画套。"
    l_gpt "今天只剩两件。空套收好，杯子洗净。"
    l_you "我来挑一件？"
    l_gpt "你挑，我做另一件。不要两件都拿走，逼我在旁边指挥。"
    "她挽好袖边，没把宽画笔放进杯里。杯子与笔洗分在两侧，干燥箱里也没有来客尚未领回的画。"
    menu:
        "收好公共空画套，将标签纸另夹。":
            $ gpt8_activity = "archive"
            "你将空套叠起，第一只折边卡在第二只里面。GPT看见你停手，先将自己要洗的两只杯子放稳。"
            l_gpt "外边这一角先展开。不是让你把它再压平一遍。"
            "她用空指尖指过折线，没替你抽走整只纸套。你沿折线展开，两只空套终于分开，薄衬纸仍留在原处。"
            l_you "我差一点给它叠成新的龙。"
            l_gpt "那条龙可能很难负责取画。今天先不聘它。"
            "你将未用标签纸放回原纸夹，开口朝外。私人画袋不在这里，你没把它一起收进箱子。"
            if gpt6_shared_sign_done:
                "那张有署名的取画说明仍夹在干套外层，取画的箭头没有被折进标签纸里。"
            "GPT在水盆边洗两只杯子，洗完分开放在干净布上。你收好最后一只纸套，她恰好把水倒净。"
            l_gpt "你这边好了？"
            l_you "好了。纸没被挤皱，标签也另外放了。"
            l_gpt "我的两只杯子也还是两只。没有趁你不看，多加一壶。"
        "洗净两只杯子，让她归好公共空画套。":
            $ gpt8_activity = "tea"
            "你端起两只杯子。GPT将空套逐一叠好，把薄衬纸放回原处，再将未用标签纸另夹。"
            if gpt6_shared_sign_done:
                "她将那张有署名的取画说明留在外层，纸上哪一处曾被木夹夹住，仍找得到。"
            "你在水盆旁转动杯子，杯底有一圈浅茶色。她隔着桌沿看见，刚要指你，手却停在自己的纸套上。"
            l_gpt "那一圈不是裂痕。多转一下就能看清。"
            l_you "你先顾好那一角，它要滑下来。"
            "她低头扶住纸套，笑了一声。你将茶色洗去，杯口朝下放在干净布上，没用旁边洗画笔的水。"
            l_gpt "你还管我。"
            l_you "不然又要多收一地纸。"
            "她抱着空套放回架上，回来时自己拿了擦桌的布。你洗好杯子，她将最后一点水痕擦净。"
            l_gpt "好了。今天这个桌沿，不必再画得比真的稳。"
            l_you "先别靠着。布还在这里。"
    "两件小事各自做完，GPT把水盆收走，拉回自己的椅子。桌中央剩下一片完整的空面，没有被她马上铺上新委托。"
    l_you "现在轮到你挑一件？"
    l_gpt "有一件。不过我想先问你，愿不愿意看。"
    "她将手伸向椅旁的私人画袋，停在袋扣上。你坐回自己的位置，她才将袋子放到两个人都看得见的桌边。"
    return

label gpt08_scene3:
    $ chapter = "GPT 第八章 / 03 · 私人袋里的新纸"
    scene bg echo morning with dissolve
    show sprite gpt as gpt at sprite_breathe(0.62) with dissolve
    "GPT先取回洗净的小杯，重新给两个人各沏半杯茶。这回她自己试过浓淡，才将你的那杯放到你伸手能拿的位置。"
    l_gpt "比第一口好一点。我刚才差点为了证明它好，又泡得更浓。"
    l_you "还好你先喝了自己的。"
    "她低头看看杯底，端起来又喝一口，才将它放到纸袋外。你们的笔都留在另一侧，不必轮流担心碰倒茶。"
    l_you "可以看。你想收回去，也先说一声。"
    "GPT解开袋扣。旧的无表情练习各有隔纸，没有被今天的杯子压住；一张新纸靠在最外面，纸边干燥，尚未写字。"
    if gpt3_pose == "laugh":
        "她把笑出声的那张翻到一侧，粗眼角线与未完成的另一边都留着。你的手没有伸去替那一侧补一笔。"
        l_gpt "它今天还是这样。新纸不是叫它下班。"
        l_you "那张笑得比你今天喝第一口茶的时候自在。"
        l_gpt "第一口茶，不列入展示。"
    elif gpt3_pose == "quiet":
        "安静侧脸仍留着铅笔短影，头发一束只有粗轮廓。她没有因为窗边有人看着，就将嘴角加成招待笑。"
        l_gpt "这张先不动。今天我想试另一件。"
        l_you "我没有带橡皮来。"
        l_gpt "很好。省下我把它推远的功夫。"
    else:
        "她只翻开自己的几张旧练习，没指出哪一张曾由你陪着留下。你看过，她便将隔纸盖回，拿出那张新纸。"
    "新纸被她平放在桌上，靠窗的一边是给她的。她把两支削好的铅笔放开，没有先在纸上替你画一张脸。"
    if gpt8_reply == "love":
        l_gpt "昨天说过，如果画我们两个人，要先问。今天可以试吗？"
        l_you "可以。你画自己的那一边，我画我的。"
        "她看了看纸，又看你，伸手将正中那条想象中的分界往旁边挪了一点。纸面没有真的划线。"
        l_gpt "你要是画得太大，我可以往边上坐。只限纸里。"
        l_you "桌边这个位置也给你留着。"
    elif gpt8_reply == "wait":
        l_gpt "我想先画自己今天的样子。旁边留一点空，不写称谓。"
        l_you "我能画窗沿吗？先不画两个人。"
        "她将另一张小纸推给你，新纸上属于她的那一边仍空着，等她自己下笔。"
        l_gpt "能。窗沿不用替我们答应什么。"
        l_you "它先负责别让茶杯滑下去。"
    elif gpt8_reply == "friend":
        "她又取出一张纸，将两张分开，一张摆到你面前，另一张留给自己。"
        l_gpt "今天各画各的。你想从哪一处开始？"
        l_you "从杯垫。它比窗外那棵树少很多叶子。"
        l_gpt "这回你挑得很稳妥。我可能又要画得太满。"
    else:
        l_gpt "今天想试画窗边。先一人一张，不替你决定坐在纸里的哪一边。"
        l_you "那我先看你下第一笔。"
        "她将一张纸留给你，自己先描杯子的外沿。你们之间没有被新纸悄悄写成恋人的名字。"
    "GPT转动铅笔，看着落下的第一笔，没有立刻拿出橡皮。你也拿起属于自己的那支，笔尖在纸边试了一小下。"
    l_gpt "你刚才这一下，很像我喝茶时的眉头。"
    l_you "不是故意的。现在还来得及把它改成杯垫。"
    l_gpt "先留着。我想看看你怎么往下接。"
    "她把自己的铅笔落回纸上，两人各自安静了一阵。院外有人路过，她抬头看见你还在这里，没拿委托单将你叫去门边。"
    "你想将铅笔削尖一点，手刚伸向桌角的小刀，她已扶住一张垫纸。木屑落在纸里，没有散到杯垫上。"
    l_you "这一下倒很熟练。"
    l_gpt "是。这个不必故意学得笨一点。"
    "你将小刀放回桌角，她合起垫纸，顺手把你够不到的那支笔推近。自己的纸始终留在面前，第一笔没有被擦掉。"
    return

label gpt08_scene4:
    $ chapter = "GPT 第八章 / 04 · 今天怎么坐"
    scene bg echo morning with dissolve
    show sprite gpt as gpt at sprite_breathe(0.61) with dissolve
    if not gpt8_reply_confirmed:
        "你们暂时停笔。GPT将新纸转到自己面前，看过又放平，没有用一幅画替两个人决定相处的名字。"
        l_gpt "还有一句，我想当面说。我喜欢你，是想和你谈恋爱的喜欢。"
        l_you "我听着。"
        l_gpt "今天的茶和画都已经摆在这里。你的答复，不必拿它们抵。"
        menu:
            "我也喜欢你，想和你以恋人身份继续。":
                $ gpt8_reply = "love"
                $ gpt8_reply_confirmed = True
                l_you "我也喜欢你，想和你以恋人身份继续。"
                "她看着你，先笑了一下，才慢慢将握在掌心的铅笔松开。"
            "我在意你，还没想清楚恋爱的答案。":
                $ gpt8_reply = "wait"
                $ gpt8_reply_confirmed = True
                l_you "我在意你，还没想清楚恋爱的答案。"
                "她点头，将新纸留在自己手边，没有往你的那张纸上补一个称谓。"
            "我想以朋友身份和你继续相处。":
                $ gpt8_reply = "friend"
                $ gpt8_reply_confirmed = True
                l_you "我想以朋友身份和你继续相处。"
                "她安静了一会儿，低头理齐自己的纸角，再抬头看你。两张纸仍各自放着。"
    if gpt8_reply == "love":
        if gpt7_reply not in ("love", "wait", "friend"):
            l_gpt "我想和你一起画一张。你画自己，我画自己，可以吗？"
            l_you "可以。刚才两张也分别收好。"
            "她另取一张稍大的新纸，先将刚才各画的练习分别夹好。两个人重新下笔，各自画自己的那一边，没有临时把原画拼成合照。"
        l_gpt "我想把椅子挪近一点。可以吗？"
        l_you "可以。这里留得下。"
        "她挪过来，先让两只椅脚站稳，才将肩侧轻轻靠到你的袖口。你把杯子移远，没有用画纸挡住她的脸。"
        l_gpt "刚才看见你端杯子，我差点又想问，需不需要我来。"
        l_you "你自己的杯子还没喝完。"
        l_gpt "所以我先拿了自己的。你看，今天有进步。"
        "她笑着端起茶，喝完才放回杯垫。你们肩侧分开，她仍坐在近一点的位置，各自够得到纸和笔。"
        $ hide_speaker_portrait = True
        call show_main_cg('gpt_shared_drawing')
        l_gpt "等画完，我想去窗边坐。今天不接一张新单。"
        l_you "和你一起。也不用一直画到窗外黑下来。"
    elif gpt8_reply == "wait":
        if gpt7_reply not in ("love", "wait", "friend"):
            "她另取一张纸，开始画自己在窗边的样子。刚才那张杯子练习夹在一旁，没被拿来代替你的答复。"
            l_you "那我把自己这张接成窗沿，不占你那一边。"
            "你沿试笔的小线描出窗角，停在纸边，没有往她留出的空白添人。"
        l_gpt "我想下午先收笔，晚上自己出去。不是让你坐到我回来。"
        l_you "我也还有自己的事。走之前，帮你把窗下的位置留出来。"
        "她把写生笔包拿到桌旁，检查过两支常用的笔，没将里面另一支抽给你，安排成两个人的夜间行程。"
        l_gpt "下周休息那天，还想来试一次茶吗？只说下一次见面。"
        l_you "想来。前一天我来问你是不是方便。"
        l_gpt "好。我也先看自己有没有想去的地方。不是一直空着。"
        "你们将这次话说到这里。她在自己的小本里只写试茶，没有给下一页画一个必须填答案的格子。"
        l_gpt "今天我能把画留成这样。下次想再谈，我会叫你。"
        l_you "我有想说的，也会说。"
    else:
        l_gpt "我下午想自己再画一张。你准备去哪儿？"
        l_you "去街角取书。今天这张，我想带回去。"
        l_gpt "带吧。你自己的那张不用向我申请收藏。"
        "她将一只空纸套推给你。袋扣上的手松开后，她又把自己的纸往窗边移了移，挑更亮的一处补线。"
        l_you "那我先等它收好，再走。"
        l_gpt "可以。我今天还不太想拿那些话开玩笑。你正常坐着就好。"
        "你没有重新追问朋友的意思。她也没将那一小段安静塞满招待话，铅笔落在纸上，接回刚才停住的线。"
        l_gpt "下次若看见我在门边写价钱，先看看是不是给你的。"
        l_you "茶钱另算？"
        l_gpt "苦成今天这样，暂时不好意思算。"
    return

label gpt08_scene5:
    $ hide_speaker_portrait = False
    $ chapter = "GPT 第八章 / 05 · 宝藏里有空位"
    scene bg echo morning with dissolve
    show sprite gpt as gpt at sprite_breathe(0.63) with dissolve
    # 恋人线的共同作画CG在场4；此处回到收画与喝茶，不让绘画动作停留在纸已收好之后。
    if gpt8_reply == "love":
        "午后的光移到纸边。你们各自补完属于自己的部分，GPT将两支铅笔放开，先把自己的名字写在纸下，再将笔递给你。"
        "你写好名字。纸上没有价钱，也没有替哪位来客预留的交付日期；两个人的线挨得近，仍能看出各自怎样下笔。"
        l_gpt "这张先由我们收着。不放到门口让人认购。"
        l_you "你那一边有一条线没擦。"
        l_gpt "看见了。它和你那一边靠得挺好，先留。"
        "她将新画夹进单独的纸套，再放入私人袋。旧练习仍隔着衬纸，没有被这一张压成该丢的东西。"
        l_you "以后打开看，要先念目录吗？"
        l_gpt "目录很短。旧的、新的，还有没画好的。"
        "她扣到一半，手指停住，自己笑了。画袋被放到自己的椅后，她拉回窗边那张椅子，给你留出能并排坐的位置。"
