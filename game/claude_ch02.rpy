# Claude个人线第二章候选 / 第九日 / 全员成年三十岁。
# 外层runner负责章节入口、断点和保存；本章只写自己的完成标记。
# 沿实存背景与立绘；护书spread动作有原创CG，其余分支不自动解锁。

default persistent.main_claude_ch02_seen = False
default claude2_previous_invitation = ""
default claude2_previous_break = ""
default claude2_previous_pages = 0
default claude2_drying = ""
default claude2_pause = ""
default claude2_private_kept = False
default claude2_shared_line_read = False

label claude_ch02:
    $ claude2_previous_invitation = getattr(renpy.store, "claude1_invitation", "")
    $ claude2_previous_break = getattr(renpy.store, "claude1_break", "")
    $ claude2_previous_pages = getattr(renpy.store, "claude1_private_pages", 0)
    if claude2_previous_pages != 2 or claude2_previous_invitation not in ("place", "time") or claude2_previous_break not in ("steps", "table"):
        $ claude2_previous_invitation = ""
        $ claude2_previous_break = ""
        $ claude2_previous_pages = 0
    $ claude2_drying = ""
    $ claude2_pause = ""
    $ claude2_private_kept = False
    $ claude2_shared_line_read = False
    call claude02_scene1
    call claude02_scene2
    call claude02_scene3
    call claude02_scene4
    call claude02_scene5
    $ persistent.main_claude_ch02_seen = True
    return

label claude02_scene1:
    $ chapter = "Claude 第二章 / 01 · 第四本不在名单上"
    scene bg echo rain with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "第九天清早，一场急雨把东廊的石阶刷亮。你走进檐下时，Claude正把一只湿借书篮往桌内移。"
    "她接过你收好的伞，给伞尖垫上旧布，又要替你把袖口的水擦掉。布已经拿到一半，你先挽起了袖子。"
    l_you "我自己来。书还在滴水。"
    "她将布递给你，转身把窗关小。窗闩滑回原位，东侧的风才不再直接吹到书桌。"
    l_cl "早晨我让人从这边进，少绕一个弯。没看见这扇窗还开着。"
    l_you "这一弯省到屋里了。"
    l_cl "先不用夸它。"
    "篮里有三本公共借书：镇路图册、花木册和旧菜谱。图册裹了厚纸，另外两本的外沿都沾着水。"
    "她把借阅单从篮底取出来，递给你。单子装在小油纸袋里，姓名和编号还看得清。"
    l_cl "请按这张认。封面湿了，先别往上贴名字。"
    "你逐本找到编号。她将干净垫纸铺到桌上，最后又从自己随身的布袋里取出一本蓝封的小书。"
    "袋口也淋湿了。蓝封边缘贴着她的手心，露出一顶端正得有点可疑的礼帽。"
    if claude2_previous_pages == 2:
        l_you "门房今天也走雨里？"
        l_cl "帽子先湿了。汤勺还在里面。"
        "你认出《第七位嫌疑人》。两枚写着猜测的窄书签都在她昨晚换好的纸套里，没有被雨打湿。"
    else:
        l_you "这一册没写在单子上。"
        l_cl "《第七位嫌疑人》。我买的，不借出。"
        "封底的小船上，有人正用一把汤勺划水。她的拇指挡住船边，没挡住那个快要掉进河里的勺柄。"
    "她把蓝封书放在三本公共借书旁，拿起编号纸，笔尖几乎碰到封面。你将借阅单朝她转了转。"
    l_you "这里只有三行。"
    "Claude停住。她把那张编号纸放回盒子，将自己的书挪到桌子另一侧。"
    l_cl "这一本放错了。我的。"
    l_you "第四位可以用自己的名字。"
    l_cl "它不会自己回答。先别给它排队。"
    "她翻开蓝封前面的护页，湿的是包书纸和护页外角，里面的正文仍干着。书脊那段翘线却又露了出来。"
    "Claude用指腹按住线头，想再塞回封边，手上的一点水立刻把纸角蹭深了。她放下书，先擦干自己的手。"
    l_you "你也得换一块干的。"
    l_cl "知道。刚才那块先给伞了。"
    "她取下旧包书纸，用两张不同颜色的垫纸划出位置。三本公共借书留在靠内的一边，小小说单独放在另一边。"
    return

label claude02_scene2:
    $ chapter = "Claude 第二章 / 02 · 两只手先放哪里"
    scene bg echo rain with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "公共借书的外封已经拭去浮水。花木册和旧菜谱暂时摊在各自的垫纸上，湿纸角没有被硬往外拉。"
    "Claude将篮子搁到地面，给自己的小书也换了干垫纸。前后护页已经能分开，她托着松动的书脊，不敢抽手。"
    l_you "我要帮哪一边？"
    l_cl "等一下。我先把两边都……"
    "她伸出空着的那只手，想去压另一张垫纸。袖口碰到水杯，杯子滑出一点，你赶紧将它拿走。"
    l_you "先少一边。"
    l_cl "对。杯子也不需要晾。"
    menu:
        "先摊开她已经分开的两张护页。":
            $ claude2_drying = "spread"
            l_you "你扶着书脊，我把护页放稳。"
            l_cl "只动已经分开的。这个角还黏着。"
            "你用干指尖托住能翻动的护页，慢慢放到垫纸上。她一直扶着书脊，手背离你的手背很近。"
            $ hide_speaker_portrait = True
            call show_main_cg('claude_wet_book')
            "雨水从檐口落下一串。你顺着声音抬头，手里那张薄纸也跟着抬了半寸，Claude立刻叫住你。"
            "她没松开书脊，右手抬起来，食指指向你手里的那一页。"
            call show_main_cg('claude_wet_book_warn')
            l_cl "看书。屋檐会自己看雨。"
            l_you "我以为它落到桌上了。"
            l_cl "还隔着一根柱子。你先不要搬整间廊。"
            $ hide_speaker_portrait = False
            scene bg echo rain with dissolve
            show sprite claude as claude at sprite_breathe(0.65) with dissolve
            "你重新将护页放平，另一只手扶稳桌沿。她等你放好，才把托书脊的手一点点挪到下面。"
            "书封底朝着外侧，那把汤勺终于完整露出来。你发现勺柄的末端还画着一个很小的结。"
            l_you "他把绳子绑上了。"
            l_cl "总算知道勺子会掉。"
            l_you "你之前没看见这个结？"
            l_cl "没有。刚才还想教他用桨。"
            "她的手仍托在书脊下，眉头却松了。你用一个干木夹压住垫纸的边缘，没有夹那张湿护页。"
            "小说占了半张桌，菜谱旁边的空位小了一些。Claude将登记盒搬到高凳上，给公共借书留出完整的垫纸。"
            l_cl "登记时叫我。别往这本上放单子。"
        "先去干柜拿两条干布。":
            $ claude2_drying = "cloth"
            l_you "我先取布。你不用再伸第三只手。"
            l_cl "柜子上层。下层那两条刚擦过窗。"
            "你把两条干布抱回来，一条叠好放在她手边，另一条先吸掉桌边的水。她将小书暂时留在干垫纸中央。"
            "你擦到纸边，发现衬纸翘起来要往湿处滑。Claude用干净的指尖按住一角，你也按住对面那一角。"
            l_you "这一张很想出门。"
            l_cl "出去以后，它会比书还湿。"
            "你们一起稳住垫纸。她伸手拿布，碰到你的指背，停了一下，等你抽开手再把布递到另一侧。"
            l_cl "这里给你。擦桌子就好。"
            "等桌面不再积水，你将干布的一边折成小垫。她把书稍稍托起，你从下面将已经潮掉的那张衬纸换出。"
            "新衬纸比书封宽一点，你习惯地要折成一样大，Claude伸手挡住折线。"
            l_cl "多出来的先留着。我还要把它端起来。"
            l_you "包装没过审？"
            l_cl "人还没把手抽出去。别先替人封箱。"
            "你把折了一半的纸展开，露出拿取的边。她将干布留在书旁，没有裹住正文，也没有把书混回篮子。"
            "封底的小船还被垫纸遮着。你刚想揭开，Claude指了指自己的手，掌心仍在托住松动的书封。"
            l_cl "先等我放稳。船今天不会开走。"
    "书安稳落在自己的垫纸上。Claude终于把两只手都松开，伸直发僵的指节，先喝了一口桌边的水。"
    "她将带出来的旧包书纸摊到空篮里，那点蓝色油墨已经印在里面，不能再包回书上。"
    l_you "这本等会儿怎么带走？"
    l_cl "换张干纸。我会留着它。"
    "她说完，看看单独放着的小书，又去给另外三本核一次编号，没有给自己的书补公共的那一行。"
    return

label claude02_scene3:
    $ chapter = "Claude 第二章 / 03 · 少看了一面"
    scene bg echo morning with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "十点半，雨已经停了。Claude只将窗推开一条缝，光落到桌外，花木册的纸角仍留着深一点的湿痕。"
    "早晨登记的镇民回来取书。她先拉开椅子，给人放下手里的篮子，然后从盒里取出一块小牌。"
    "‘可取’被她摆到花木册旁。你看一眼书角，再看一眼那块牌，手指停在牌的另一面。"
    l_you "这个也要翻一页。"
    "她拿起来，背面写着‘晾书中’。Claude将牌转回去，压在不会碰到书页的地方。"
    l_cl "拿反了。还有两处湿的，午后再来看。"
    "来人已经把空篮移到桌沿，听完又将篮子抱回去。她取出干着的镇路图册，让对方先翻所需要的那一页。"
    "对方看清路口后，道谢离开。Claude记下花木册还留在桌上，又把那只多拉出来的椅子推回去。"
    l_you "你要他坐，他以为马上能带书走。"
    l_cl "我先看到篮子，没看到牌。"
    "她把牌留在自己看得见的方向，没有再替来客写一份更细的取书路线。手边的小本子却已经打开了。"
    l_you "还有一张要翻。"
    "她顺着你的目光低头。本子那页写着午饭，后面跟了三个人名，没有她自己的。"
    l_cl "这回不是忘写。我还没选。"
    l_you "先别替我选。"
    l_cl "我今天记得了。"
    "她把铅笔转过来，橡皮那头指着你。你没往后退，她只好先笑一下，将笔横放在本子上。"
    if claude2_drying == "spread":
        "旁边的小说还摊着护页，封底的小船朝向来客刚坐过的椅子。Claude注意到那只汤勺，忽然想将封底盖起来。"
        l_you "他已经走了。"
        l_cl "刚才他问，这种船能不能过河。"
        l_you "你怎么答的？"
        l_cl "我说自己在看装订。"
        "她看着被扶了半天的书脊，手却没有真的去合湿护页。窗缝来的风吹动垫纸，木夹仍把它压在原位。"
        l_you "连装订也没来得及看。你都在扶它。"
        l_cl "看过线头了。不算全说错。"
    elif claude2_drying == "cloth":
        "干布还叠在小说旁，宽出来的衬纸挡住了一半封底。Claude用指腹抚了抚空出来的边，没再折回去。"
        l_you "这张包装合格了？"
        l_cl "拿起来不碰书。合格。"
        "她稍稍托起小书，让你看从下面换出来的那张潮纸。蓝色痕迹留在纸上，没有蹭到旁边的登记单。"
        l_you "这么宽，来人没问你要包什么？"
        l_cl "问了。我说等会儿带回去看。"
        l_you "你说出来了。"
        l_cl "没说有一把汤勺。"
    "她挪到自己的那一边桌角，第一次把小说封面的题目完整朝着你。里面没有夹新委托，只有她原来留下的纸签。"
    l_you "还打算给谁看？"
    l_cl "先给我自己。你想看，我会把页转过来。"
    "你将空篮提到桌下，让两种垫纸之间重新空出一条缝。她顺着那条缝把公共借阅单摆正，没推到小说上面。"
    return

label claude02_scene4:
    $ chapter = "Claude 第二章 / 04 · 先听一句，还是先吃一口"
    scene bg echo morning with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "十一点半，公共借书仍在晾位，编号与去处已经记好。Claude将登记盒收进干柜，高凳上终于没有纸要你托住。"
    "她摸一摸小说的护页角。那一角不再沾手，只比原来皱些；正文还保持着清早翻开时的干燥。"
    l_cl "可以拿起来了。"
    "她用两手托起小书，没有再去压公共菜谱那一边。菜谱自己的垫纸已经放稳，窗也没开大。"
    if claude2_previous_invitation == "place":
        "你看一眼雨后的台阶。她顺着你的目光望过去，伸手点住干着的廊内一侧。"
        l_cl "今天先不照你那三层图走。石面还湿。"
        l_you "阴影可以在这里坐。"
        l_cl "你倒是很替它操心。"
    elif claude2_previous_invitation == "time":
        "她把小日程本翻到新的一页，午饭那格还没填名字。你将铅笔往她那边推了一点。"
        l_you "第五位今天选什么？"
        l_cl "你等她想好。不要先送座垫。"
        "她在自己的名字旁边写了一个‘甜’，没有抄昨天那行脆边。"
    else:
        "你问她还要忙多久。Claude看了一眼晾书牌，没给它另添一个保证能干的时刻。"
        l_cl "先吃午饭。纸角让它慢慢干。"
        "她将自己的名字补在午饭那格，没有把你也写进去，抬头等你说要吃什么。"
    l_you "小说呢？"
    l_cl "想再看一小段。只一段，不是今天读完。"
    "她把书放到自己手里，像是怕一放到桌上，又会被别的纸夹住。午饭本子则留在你也能看见的地方。"
    menu:
        "先留半张干桌，听她想读的那一段。":
            $ claude2_pause = "line"
            l_you "先听一段？湿书不用挪，我清这边的空杯。"
            l_cl "好。读完我去取饭。你也想吃甜的？"
            l_you "我想吃咸的。各买各的就好。"
            "你将桌边杯子移到柜旁，擦净桌面，再将那只高凳拉到旁边。她坐下，把小说平放在已经干透的这一小块桌上。"
            "Claude翻开书，先用手指顺着一行印得很小的字走。你凑近看，发现是封里写着的印刷说明。"
            l_you "汤勺什么时候入场？"
            l_cl "翻快了。稍等。"
            "她往后翻到第一章，跳过一处已经夹好的纸签，终于找到自己想念的那几行。"
            l_cl "门房说，给帽子里的面粉找一个合适的位置。"
            l_you "厨房？"
            l_cl "他倒进了隔壁那个人的帽子。"
            "你看了她一眼，发现她也在忍笑。书上的两顶帽子又印成同样大小，装面粉的那顶却忽然多了一个盖子。"
            l_you "他家是不是卖罐子的？"
            l_cl "下一句没有写。请先允许我笑完。"
            "她笑得肩膀轻轻一动，手指仍留在那句下面，没有在旁边标记应当改成什么。你也没替这顶帽子补铰链。"
            "念到这几行结束，Claude从干柜里取出一张新的空书签，夹在刚才那段旁边。她合上书，移回私人那一侧，收起日程本准备去取饭。"
            l_you "不再念一段？"
            l_cl "肚子不同意。下午再说。"
            "她问清你要的咸馅，带着两人的零钱出门。你留下照看公共晾位，没有把自己的选择写进她的午饭格。"
            "接近中午，她回来时抱着两个纸袋，甜的和咸的各画了不同的小记号。这次没靠记忆给你分。"
            "你们照记号各拿一袋。她掰开自己的甜包，先吃了一口，没有把软的那半边放到你面前。你也没去拿她的豆沙。"
        "先取午饭，回来请她挑自己想读的一段。":
            $ claude2_pause = "meal"
            l_you "我先去取午饭。你想吃什么，自己点。"
            l_cl "豆沙包。一个就好，另外要一小碗汤。"
            l_you "记下了。我的买咸馅。"
            "你拿出一张干便纸写好两份，各画一个小圈。Claude伸手想补取饭路线，指尖碰到‘豆沙’两个字，又慢慢收回来。"
            l_cl "摊子你认得。别把这张也送回我。"
            "你出门前，问她愿不愿意先挑一段。她点头，把小说放到腿上，椅子离公共晾位有一臂远。"
            "接近中午，你回来时，干柜的门已经合好。她正握着铅笔，笔尖在一张新的空书签上停着。"
            l_you "要替门房报失？"
            l_cl "想记住一段。你把汤放高凳上，别放在书旁。"
            "她接过豆沙包，先用手背碰一下纸袋的热气。你们把午饭放到空出来的高凳上，小说另留在干桌面。"
            "吃过半个包子，她擦净手，将书转向你。那一段中，门房把帽子里的面粉倒进了隔壁那个人的帽子。"
            l_you "换个罐子不就好了？"
            l_cl "他连帽子都没有选对。再给罐子，今天就读不完这一段。"
            "她想保持平常读稿时的语气，读到帽子忽然多了一个盖子，自己先停了下来。"
            l_you "这里换气？"
            l_cl "笑。等一下再换气。"
            "你们把那几行念完，Claude将空书签压在封里。上面没写勘误，只画了一顶带盖子的帽子。"
            "你收起自己的半个咸包子，没有拿她的豆沙当边角交换。她吃完另一半，才重新摸到书签的位置。"
    $ claude2_shared_line_read = True
    "小说还停在第一章，没有跳到结尾。她只把那张新纸签夹在刚才读过的一小段旁，书页没收到借阅章。"
    l_you "真想读完它？"
    l_cl "想。装订也许不用再看一遍。"
    "她把书封上的水痕朝向自己，用干净的拇指沿边擦过。动作很轻，没有把那句可笑的话藏回纸底。"
    return

label claude02_scene5:
    $ chapter = "Claude 第二章 / 05 · 写自己的名字"
    scene bg echo morning with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "十二点一刻，午饭的纸袋已经收好。Claude往干柜旁留了一张晾位便纸，写清花木册与菜谱仍要继续放着。"
    "镇路图册已经收回自己的格子，外封没有粘到私人小说。她找一张干净的新包书纸，摊在空出来的桌面。"
    if claude2_drying == "spread":
        "你松开压着小说垫纸的木夹。她再托住书脊，你将新包书纸从下面送过去，手没有为了看屋檐抬起来。"
        l_cl "这一回很稳。"
        l_you "屋檐看完雨了。"
        l_cl "终于肯把书还给自己的手。"
        "她将已经不粘手的护页收拢，包书纸边缘留得宽些。那把画在封底的勺子没有被你们的指尖挡住。"
    elif claude2_drying == "cloth":
        "你取走小说旁的布，和擦桌子的那条一起搭到廊口的晾杆上。她托起小书，你再次按住新包书纸对面的一角。"
        l_you "这张还用压？"
        l_cl "换完就松。你也得留手吃下午的点心。"
        "你们等书落稳才一起松手，没有把多出来的边急着折到一样齐。她试着端起来，纸没有从掌心滑走。"
    "Claude拿起铅笔，习惯地先写一个‘待’字。笔尖停在第二个字的位置，迟迟没往下走。"
    l_you "待谁来领？"
    l_cl "我自己。"
    "她把‘待’划掉，在新纸上写自己的名字。小书没有公共编号，也没有被放进已经擦干的借书篮。"
    $ claude2_private_kept = True
    "你问她能不能再看一眼封底。她把纸边展开，托着小船那一页转给你，等你看清才收回。"
    l_you "他用勺子真能划回来？"
    l_cl "我想看他吃饭的时候怎么办。"
    "她说完就笑了，连装订的借口也没有补。你把登记牌留在公共晾位前，她将自己的书装进干着的内袋。"
    if claude2_previous_break == "steps":
        "廊外的石阶还有一条水痕。她看见你往那边望，先将布袋口扣好，没有把昨天用过的茶盘端出去。"
        l_cl "今天不坐湿台阶。等它干，不用照昨天的时刻再来一遍。"
        l_you "那张邀请已经合格了。"
        l_cl "合格的纸也不用天天执行。"
    elif claude2_previous_break == "table":
        "你们昨天并排放过杯子的桌角，现在留给公共湿书。她把旁边的椅子收回一点，没替旧位置重新倒茶。"
        l_cl "今天这半张先给纸。想再读，换一张干桌。"
        l_you "今天不用在桌边数人了。"
        l_cl "帽子可以明天再数。等他们自己进门。"
    else:
        "你看了看还要继续晾的两本书。她把椅子推到不会挡住晾位的地方，让来取书的人能直接看见牌。"
        l_cl "午后他们会自己回来。我先带这一册走。"
    "她的手又伸向收件夹，夹边露出两张新送来的短稿。Claude看见自己的布袋已经放在臂弯，手停了一下。"
    l_you "要把夹子也带去？"
    l_cl "今天带不下。"
    "她将夹子留在干柜外的收件位，给新稿压上木夹。木夹没有贴到布袋上，她的手也没有伸进去换一本更体面的书。"
    l_you "以后想在哪里读？"
    l_cl "河边。不带这个夹子，带一本书。"
    "她望了一眼还湿着的石阶，没立刻往河边走。你替她移开脚边的空篮，她抱着干布袋，先走到廊里不会滴水的那一侧。"
    "那张刚被她握过的包书纸还带着一点手心的暖。她在走出前重新看了一眼上面的名字，没有把它改成别人的。"
    return
