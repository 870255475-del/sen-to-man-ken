# 千to万ken / Claude 第七章 / 想靠近，是真的 / 第十四日。
# 全员成年三十岁，玩家无立绘。普通 call/return；沿用画像与服装。
# root集成四CG之一组：同一河边事件沿句切换；局部答复不写结局、完整通关或周目。

default persistent.main_claude_ch07_seen = False
default claude6_completed_run_id = None
default claude7_completed_run_id = None
default claude7_answer_run_id = None
default claude7_has_ch06 = False
default claude7_previous_start = ""
default claude7_previous_pause = ""
default claude7_previous_guess = ""
default claude7_invitation_written = False
default claude7_invitation_received = False
default claude7_snack_help = ""
default claude7_snack_saved = False
default claude7_private_time_kept = False
default claude7_arrived = False
default claude7_invitation_spoken = False
default claude7_answer = ""
default claude7_answer_heard = False
default claude7_close_asked = False
default claude7_close_agreed = False
default claude7_wait_revisable = False
default claude7_friend_plan = False
default claude7_snack_shared = False
default claude7_paper_kept = False
default claude7_day_closed = False
default claude7_novel_chapter = 2

label claude_ch07:
    # seen本身不构成昨日。父断点、完整06行为及分支排他值须成立。
    $ claude7_has_ch06 = getattr(persistent, "main_claude_ch06_seen", False) is True and getattr(renpy.store, "main_last_chapter", "") == "claude_ch06"
    $ claude7_has_ch06 = claude7_has_ch06 and all(getattr(renpy.store, "claude6_" + k, False) is True for k in ("map_returned", "public_clear", "new_time_agreed", "pause_used", "old_guess_written", "guess_admitted", "old_guess_kept", "second_chapter_finished", "time_kept")) and getattr(renpy.store, "claude6_novel_chapter", 0) == 2
    $ claude7_has_ch06 = claude7_has_ch06 and ((getattr(renpy.store, "claude6_reading_start", "") == "her" and getattr(renpy.store, "claude6_pause_sign", "") == "cup") or (getattr(renpy.store, "claude6_reading_start", "") == "you" and getattr(renpy.store, "claude6_pause_sign", "") == "marker"))
    $ claude7_has_ch06 = claude7_has_ch06 and ((getattr(renpy.store, "claude6_guess_play", "") == "pair" and getattr(renpy.store, "claude6_player_guess_written", None) is True and getattr(renpy.store, "claude6_readback_done", None) is False) or (getattr(renpy.store, "claude6_guess_play", "") == "readback" and getattr(renpy.store, "claude6_player_guess_written", None) is False and getattr(renpy.store, "claude6_readback_done", None) is True))
    $ claude7_has_ch06 = claude7_has_ch06 and getattr(renpy.store, "claude6_completed_run_id", None) == getattr(renpy.store, "ending_route_run_id", "") and (not getattr(renpy.store, "ending_route_run_id", "") or (getattr(renpy.store, "ending_route_run_role", "") == "claude" and 6 in getattr(renpy.store, "ending_route_run_chapters", ())))
    $ claude7_previous_start = getattr(renpy.store, "claude6_reading_start", "") if claude7_has_ch06 else ""
    $ claude7_previous_pause = getattr(renpy.store, "claude6_pause_sign", "") if claude7_has_ch06 else ""
    $ claude7_previous_guess = getattr(renpy.store, "claude6_guess_play", "") if claude7_has_ch06 else ""
    $ claude7_completed_run_id = None
    $ claude7_answer_run_id = None
    $ claude7_invitation_written = False
    $ claude7_invitation_received = False
    $ claude7_snack_help = ""
    $ claude7_snack_saved = False
    $ claude7_private_time_kept = False
    $ claude7_arrived = False
    $ claude7_invitation_spoken = False
    $ claude7_answer = ""
    $ claude7_answer_heard = False
    $ claude7_close_asked = False
    $ claude7_close_agreed = False
    $ claude7_wait_revisable = False
    $ claude7_friend_plan = False
    $ claude7_snack_shared = False
    $ claude7_paper_kept = False
    $ claude7_day_closed = False
    $ claude7_novel_chapter = 2
    call claude07_scene1
    call claude07_scene2
    call claude07_scene3
    call claude07_scene4
    call claude07_scene5
    call claude07_scene6
    call claude07_scene7
    $ claude7_answer_run_id = getattr(renpy.store, "ending_route_run_id", "")
    $ persistent.main_claude_ch07_seen = True
    return

label claude07_scene1:
    $ chapter = "Claude 第七章 / 01 · 纸翻到另一面"
    scene bg echo morning with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "第十四日九点三十五，东廊的门只开一半。Claude站在桌后，将一张浅色纸翻过来，又翻回去。"
    "窗边的空夹已经归柜。她桌上摆着蓝封小说、自己的小钱袋，以及一只没沾过墨的碟子。"
    l_you "纸分正反面，也需要挑这么久？"
    l_cl "反面有一小块折痕。"
    l_you "我可以从没有折痕那边看。"
    l_cl "我还没请你看。"
    "你在门边停住。她把纸压在小说下，立即发现这么放只会让那个角翘起来，又用碟子换下书。"
    l_you "这次它平了。"
    l_cl "碟子重。你不用替它加评语。"
    "她将门完全推开，自己站到门旁。你进去时，袖口被门上的木钩拦了一下，只好退半步摘开。"
    l_cl "先把自己拿进来。"
    l_you "刚才说不请我看的，也是你。"
    l_cl "看纸和进门是两件事。木钩没有第三种意见。"
    "她给你移开桌旁的矮凳。凳上原本放着布袋，袋口两条绳子缠在一起，她解错了一头，反而收得更紧。"
    "你伸出一根手指，只指那条被压住的绳。她照着拉出，袋口终于松了，里面露出一厚一薄两只座垫。"
    if claude7_has_ch06:
        l_you "厚的今天还是你坐？"
        l_cl "嗯。昨天坐过，今天不想换回去。"
        "她将厚垫摆在自己手边，薄垫另放。你没去拿，昨天那场共读并没有给今天留时刻。"
        l_you "图今天不再拿出来了吧？"
        l_cl "昨天九点二十就交回了。它该在鞋铺，不在我的袋里。"
        l_you "姚师傅也不会绕来听书。"
        l_cl "昨天九点二十五说清了。他今天按自己的路走。"
        "她将袋内的小水壶拿出来试盖。盖子扣合的声音很轻，桌上的纸却被她空出的手按住了。"
        l_you "书签没移到第三章？"
        l_cl "第二章两点四十二念完。最后那位还没出来。"
        l_you "昨天剩八分钟，你也没用来偷看。"
        l_cl "我喝茶了。两点五十收东西，没延到猜对为止。"
    else:
        "她把两只座垫分开，厚的摆在自己手边，薄的另放。没有给你说这是谁曾经坐过的位置。"
        l_cl "我想下午带这两只去河边。厚的我用。"
        l_you "你已经挑好了。"
        l_cl "坐硬凳子的时候，不能让书替我舒服。"
        "她告诉你蓝封书是自己买的《第七位嫌疑人》。位置签停在第二章末，最后的凶手还没揭开。"
        l_you "读到一半就停下，能忍住？"
        l_cl "能。猜错的人还夹在里面，没有逃掉。"
    "你以为她要把小说递过来，她却先拿走碟子。那张浅色纸终于露全，中间留着她刚写的几行字。"
    "她把纸转到自己这边，遮了一下那行字。动作太快，指尖在还没全干的最后一笔上蹭出个小点。"
    l_cl "等一会儿。"
    l_you "我等纸干？"
    l_cl "等我找一张手纸。"
    "她从公用盒抽出干纸，擦掉指尖的墨，没去擦写好的句子。纸上的小点留在句末，像一个胖了些的句号。"
    l_you "它占了两个句号的位置。"
    l_cl "只停一次。"
    "她把纸向你推近一寸，下一秒又按住左角。你等着她松手，门外的脚步过去两拨，她才抬头。"
    l_cl "今天四点十分，你愿意和我去河边吗？五点前回来。"
    l_you "愿意。还读小说？"
    l_cl "带着。先有别的话想当面说。"
    l_you "现在不能说？"
    l_cl "能。但我想在那个时刻说。"
    "她没有把邀请丢进待领纸的夹子。你的手靠近，她才松开左角，让你把整张拿走。"
    "纸上写着她刚才说的时间和地点，下面另有一行：想同你坐一会儿。落款是她自己的名字。"
    $ claude7_invitation_written = True
    l_you "这张没有校对圈。"
    l_cl "我没让它去证明什么。"
    l_you "句号胖了，也留着？"
    l_cl "留。你已经盯它够久。"
    "你把纸对折，避开未干的那一点，收进自己的口袋。她一直看着折口，确认没有粘在一起，才把碟子放回桌上。"
    $ claude7_invitation_received = True
    l_cl "还有一件小事。十点半，我想去买酸梨。"
    l_you "这句也写到纸上？"
    l_cl "不用。我现在想问你有没有空。"
    l_you "有。你想买多少？"
    l_cl "两个。吃得完的两个。"
    "她打开小钱袋，将几枚零钱数到掌心。第三枚滚到碟子旁，她按住它，又把碟子拿远。"
    l_cl "今天它只负责压纸。不能再负责收钱。"
    return

label claude07_scene2:
    $ chapter = "Claude 第七章 / 02 · 梨并不按计划变软"
    scene bg echo morning with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "十点五十分，你们把两只洗过的梨放到小台上。Claude挑的是自己想吃的偏酸口味，还买了一小包黄糖。"
    "摊主问要不要换成熟得更软的，她捏着梨柄想了想，还是付钱拿了这两个。回来削开，梨肉比她以为的硬。"
    l_you "它现在像需要借一把锯。"
    l_cl "刀够用。别把摊主的小锯也带进来。"
    "她把第一块切得很厚，咬下去时停了两拍。你看见她肩头动了一下，却一直没听到她对酸味的评语。"
    l_you "很甜？"
    l_cl "你为什么挑这个时候问？"
    l_you "你刚才很像在等我也咬一口。"
    "她将第二块递来。你尝过，舌尖发酸，忍不住去拿杯子；她终于低低地笑了一声。"
    l_cl "现在不必问了。"
    l_you "两个人一起知道，梨会比较甜？"
    l_cl "不会。你喝完水给我留一点。"
    "她喝了半杯，又端详剩下的梨。糖包在旁边，一小盆清水已经备好，她拿起空碗，想把梨切小后煮。"
    l_you "你原先就准备煮它？"
    l_cl "原先想切开直接吃。锅是刚才改的。"
    l_you "还坚持它们挑得好？"
    l_cl "我想吃酸的。没想和它比赛谁更硬。"
    "她把梨籽挖出，留下能吃的部分。你收好削下的皮，推开桌沿的糖包，给她腾出切第二只的地方。"
    "小灶只够架一口锅。她想让梨快些软，倒水时多加了半碗，糖化进去以后，锅里看起来像三人份的淡汤。"
    l_cl "我倒多了。"
    l_you "第三个人终于来了。"
    l_cl "让他拿碗。只准分水。"
    "她把火调小，没拿盖子蒙住锅装作看不见。梨块慢慢沉下去，她用木勺推一推，才闻到一点甜味。"
    l_you "下午带汤？"
    l_cl "不带。长凳没有灶，不会帮我收干。"
    "她从柜里找出一只带盖的小食盒。盒边合得稳，内侧却有两格，她忽然停手，把它又转回原方向。"
    l_you "不知道哪边装你的？"
    l_cl "两边我都想尝。"
    l_you "那我分哪边？"
    l_cl "等煮好。现在给你的是热水。"
    "水沸到锅沿，她抬手移锅，袖边差点碰到灶侧。你指给她看，她收好袖子，仍让锅留在灶上慢煮。"
    "十一点十五，梨块终于能用木勺压开。她先盛一块尝，吹了两次，第三次才进嘴。酸味还在，硬心已经软了。"
    l_cl "这个能带。"
    l_you "汤呢？"
    l_cl "留一杯午饭喝。我不想继续守它到下午。"
    "她把剩余的汁装进碗，盖好防尘。梨块放在两张薄纸托里晾凉，每张都堆得有些高。"
    "她想将纸托一并转进食盒，抬起左边，梨汁先沿折角往下跑。另一张被带得歪了一点，最上面那块开始滑。"
    l_you "先停。你要我稳哪边？"
    l_cl "右边。或者把那只平盘给我。别拿手接热梨。"
    menu:
        "稳住右边的纸托，让她自己转入食盒。":
            $ claude7_snack_help = "tray"
            "你捏住右边干着的两角，把纸托留平。Claude将左边放进盒里，再一点点松开粘着的纸。"
            "左边的梨安全落下，她抬眼看你手指的位置，将空勺柄递来，免得你一直用指尖撑着窄边。"
            l_you "纸托比梨倔。"
            l_cl "是我把它折得太小。你别给它另添脾气。"
            "你接住勺柄，托稳右边。她用自己的勺把梨分两次转过去，汁落在盒底，没有顺着你的袖口走。"
            l_you "刚才你还想两张一起拿。"
            l_cl "想省一次手。现在多用了两只。"
            "最后一块梨留在折边，她将纸轻轻展开，自己夹起吃掉。你看过去，她先把空纸举给你看。"
            l_cl "没有第三份。那块算我拿错方法的报酬。"
            l_you "你拿错，我出手，报酬还是你的。"
            l_cl "你那边盒子里也有。先别结算成一场争执。"
            "你放回勺柄，她拿干纸擦净你刚才捏住的桌沿。她收起食盒时，特意把两张破纸托留在台上，没夹进邀请纸。"
        "递来平盘，让她先把两张纸托放下。":
            $ claude7_snack_help = "plate"
            "你把平盘推到两张纸托下面。Claude先放下左边，再托住滑开的右边，让流出的梨汁停在盘沿。"
            "她站直一点，望着纸上那块摇摇欲坠的梨，拿勺把它拨回去，又把纸托整个放平。"
            l_you "现在不用悬在半空了。"
            l_cl "嗯。我刚才想让纸长出第三个底。"
            l_you "它拒绝了。"
            l_cl "它做得比我清楚。"
            "她一块块把梨移进食盒，你扶住盘，最后一小块粘在折边，她展开纸，自己夹起吃掉。"
            l_you "盘子救了它，你吃了它。"
            l_cl "不能让盘子一直救下去。它也要洗。"
            "她把盘内的汁倒进留好的碗，纸托折进废纸篮。你去接清水，她将勺子递来，说盘子自己擦。"
            l_you "这一格梨没你那边多。"
            "她低头看了看，给你添一块，又从你这边取回较小的一块。拿回去时，她的嘴角已经压不住。"
            l_cl "我想吃这块。分得一样多也不能挑错口味。"
            "你把洗净的勺放上干布。她合好食盒，特意转向你试一下扣边，没让刚洗的盘子也跟着去河边。"
    $ claude7_snack_saved = True
    "她把食盒盖上，拿一张短纸写梨，贴在盖子角上。字只有一个，贴得比那张邀请纸的句号端正。"
    l_you "这个字你倒没有犹豫。"
    l_cl "梨不会拿它问我是什么心情。"
    "你指了指午饭留着的那碗汁。她给碗换了个更大的盖子，随后自己取杯，喝掉还温着的一口。"
    l_cl "下午这盒归我带。你别到时候只看我切得整不整齐。"
    l_you "我会先吃。"
    l_cl "先听我说。吃的时候也可以。"
    return

label claude07_scene3:
    $ chapter = "Claude 第七章 / 03 · 不是多写两行就能送出去"
    scene bg echo morning with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "午饭之后，Claude把小灶熄干净，留下来的梨汁分成两杯。你喝完自己的，她把那只杯子拿走，没有再续第三杯。"
    l_cl "没有了。不要往锅里看。"
    l_you "你刚才有半锅。"
    l_cl "梨吃掉一点，午饭喝掉一点。水终于没多到晚上。"
    "她将小说取出来，封内的窄纸露出一角。你坐在桌对面，看见自己的邀请纸还安稳在口袋里，没有一起混到书封中。"
    if claude7_previous_guess == "pair":
        "她把昨日两张猜纸分别托起。借勺人在她那张，大帽子的主人在你那张；她没有将后者算成书里已经揭出的答案。"
        l_you "我的帽子还没受审？"
        l_cl "主人没受审。你又替帽子去了一次。"
        l_you "你那张还露在外面。"
        l_cl "昨天猜错的是借勺人。今天没改掉它。"
        "她把你那张也留在原来的边，指尖越过两张纸，碰到真正记录位置的书签，只确认它停在第二章末。"
    elif claude7_previous_guess == "readback":
        "她抽出昨天写的借勺人那张，纸上没新添你的名字。重读换过声音，没凭空变出一张你的猜测。"
        l_you "门房今天能把锅带走了吗？"
        l_cl "昨天说了，锅留下。今天还想拿？"
        l_you "你那句我记着。"
        l_cl "我也记着。自己那张猜错的纸还在。"
        "她把纸放回原处，只点了点第二章末的位置签。第三章露在右边，她没顺手翻开。"
    else:
        "她给你看自己留下的猜纸，写着借勺人。书到第二章末，已经替这个人排除一件事，纸上的原猜却没擦掉。"
        l_you "有这张纸，后面每次都能看见自己猜错？"
        l_cl "也能看见我先猜了谁。它不替我读后面。"
        "她将纸收回书封，给你看了看第二章的标题。你低头看看标题，她不急着替你讲掉后面。"
    "你还想问下一个嫌疑人，Claude却合上书。她把书袋内的小格撑开，确认食盒不会压到书角。"
    l_you "今天要带去，不先读一点？"
    l_cl "今天想先说自己的话。"
    l_you "怕小说里面的句子比较好听？"
    l_cl "怕我看进去，四点十分还在这里数锅盖。"
    "她从抽屉拿出另一张浅色纸。上面有三行细字，写到第三行的一半，笔迹变得很轻。"
    "她看了片刻，将它扣在桌上。你以为那是给别人的信，正要离开，她的手却轻轻拦在桌边。"
    l_cl "刚才那张邀请，带着吧？"
    l_you "在。你要补一句？"
    l_cl "不补。想确认它确实在你那里。"
    "你将纸从口袋取出，打开左边的折口。那个胖句号已经干了，折痕让她的名字停在你手边。"
    "她低头看了看，指尖朝纸边伸出，又收回去。你把纸留着，她终于说出自己刚才真正想问的事。"
    l_cl "你拿到它时，会觉得我只是另约一场读书吗？"
    l_you "我知道你想说别的话。还不知道是什么。"
    l_cl "好。下午让我说完。"
    l_you "你现在已经说了几遍下午。"
    l_cl "我听到了。现在不再给它提前。"
    "她把扣着的另一张纸收进自己的抽屉。纸角在沿口卡了一下，她重新拉开，放平，没有揉成团丢进刚装梨皮的篮子。"
    l_you "刚才那张也要带？"
    l_cl "不带。写了三行，我自己念不出来。"
    l_you "哪一行卡住了？"
    l_cl "第一行。后面只是陪它卡着。"
    "她拿过自己的杯子，才发现里面已经空了。她笑一下，去倒一杯清水，回来时把杯子摆在小说另一端。"
    l_cl "写字很容易拖得比一个人说话还长。"
    l_you "那就从第一句说起。"
    l_cl "嗯。你先把邀请收好。我不想用午饭桌把它用完。"
    "你重新折好纸。她没有给你附一张应答样式，也没问你是否已经想到了正确那句。"
    "窗边有一声轻敲，邻铺的阿澄提着门牌来，问这块能不能今天下午挂回去。Claude接过来先看了字。"
    "门牌上的一条木边松了，阿澄却以为字歪。她指给来人看松口，让他把木边送去修，自己不把它留在桌上。"
    l_cl "字没有换位置。木条在往下走。"
    "阿澄将牌举得端正，又看一次，终于发现那道细缝。他说明午后不急，问她修完是否能再看一眼。"
    l_cl "明早九点半来。今天下午我有自己的约。"
    "他说记下了，带着门牌离开。Claude在工作本写明早那格，没把四点十分旁边多挤一块木头。"
    l_you "这次不用我替你说。"
    l_cl "本来就没让你替。你可以替我把门开大一点。"
    "你把门推开，她送到廊口，回来后关上工作本。她的指尖往碟子旁一搭，那张浅色纸已经不在桌上。"
    l_cl "你收得很快。"
    l_you "你刚才让我收好。"
    l_cl "嗯。做得对。但我刚才还是想再看一眼。"
    return


label claude07_scene4:
    $ chapter = "Claude 第七章 / 04 · 到时再把杯子放下"
    scene bg river day with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "四点零五分，河边的长凳被太阳晒得发暖。Claude先用干布抹去凳沿的细灰，厚垫铺在自己这边。"
    "她在另一端留出薄垫，食盒放在中间平石上。书袋靠着自己的腿，蓝封小说没有拿出来占你坐的位置。"
    "你到时看见她正按食盒的盖子。扣边已经合好，她却将盖子取下，摸摸外侧，再重新扣回去。"
    l_you "梨想出门？"
    l_cl "我想看它有没有翻。没有。"
    l_you "从廊口到这里，你看了几次？"
    l_cl "三次。你这句算第四次。"
    "她将空出来的手放到膝边，头发被风吹到肩前。她抬手理回去，袖沿跟着滑高一点，又自己拉平。"
    "四点十分，你坐到薄垫上。她把两只干净杯子从袋里取出，水壶放在较低的石面，免得壶盖朝小说滚。"
    $ claude7_arrived = True
    l_cl "纸带了吗？"
    l_you "带了。要拿给你看第三遍？"
    l_cl "我想。刚才在桌边那次，也想看。"
    l_you "你真记了。"
    l_cl "因为我确实想看。"
    "你取出浅色纸，展开给她。风正好掀起一边，她从袋里抽出小木夹，夹住空白处，没夹住自己的名字。"
    "她看见纸上那句想同你坐一会儿，嘴唇动了一下。你以为她要再念时间，她却用自己的杯子压住平石上的一角。"
    if claude7_previous_start == "her":
        l_you "今天还是你先念？"
        l_cl "我先说。你昨天举杯想停，等到了句号。"
        "你把宽口杯移到自己手边，没有将它抬到她眼前。她看清，才把压纸的杯子换成自己的小木夹。"
        l_you "这回只是拿到方便喝水的地方。"
        l_cl "嗯。想停也可以说，不必先找一个东西举起来。"
    elif claude7_previous_start == "you":
        "她把袋内那张停读空签露给你看一下，随后放回另一格。它没跟原位置签混在一起，也没改作今天的答复纸。"
        l_cl "昨天你先念，纸签替我等到句号。今天我想先开口。"
        l_you "空签还用？"
        l_cl "不用拿它改我这句。你有话就说。"
    else:
        "她先将杯子移开，小木夹只压纸。自己的那只杯子留在膝边，刚倒好的水晃了晃，慢慢停住。"
        l_cl "今天让我先说一件事。你想停，就开口。"
        l_you "好。我在听。"
    "她点一下头，抬眼时又被对岸的吆喝打断。小船刚出桥洞，船夫叫同伴挪开岸边的竹筐。"
    "你们等那艘船靠稳，她把手从纸边移到垫角。垫子明明没有走，她仍将四个角理得很齐。"
    l_you "这个已经够平。"
    l_cl "我知道。你不要一直看我的手。"
    l_you "看你？"
    "她抬起头，目光与你碰上。刚才准备好的那口气短了一点，她没有再低头找垫子。"
    l_cl "对。看我。"
    "河面又响了一次橹声，她等着，视线这次没有跟船走。你也没伸手去拿蓝封小说，替她挑一段容易开口的词。"
    l_cl "我今天想约你来，话一直在这里。"
    "她用手指轻轻点了自己的胸口，随后把手放下。浅色纸落在平石上，只有木夹轻轻动了动。"
    l_cl "买梨的时候也在。煮多一锅水的时候也在。"
    l_you "所以梨硬成那样，你都没换？"
    l_cl "那个真是我自己挑错。别把今天全算在它身上。"
    "她吸了一口气，笑意收住，却没有把表情摆得像要退回一份不合格的稿。她朝你这边稍稍转身。"
    # CG A锚点：第14日16:10，共用告白。她坐厚垫，手离纸，抬眼克制紧张。
    # 蓝封小说合在右侧布袋，食盒合盖在平石外端，邀请只有她自己的落款。
    $ hide_speaker_portrait = True
    call show_main_cg('claude_river_confess')
    l_cl "我喜欢你。想和你成为恋人。"
    "木夹下的纸仍平整，她没去检查名字写得是否够稳。说完这句，她的手从垫角松开，留在自己膝上。"
    $ claude7_invitation_spoken = True
    l_you "你说的坐一会儿，是这个意思？"
    l_cl "也是想坐一会儿。没有书，我也想看你坐在这里。"
    l_you "你现在还在看。"
    call show_main_cg('claude_river_relax')
    l_cl "嗯。比看我的草稿难一点。"
    # CG B锚点：同镜位转身稍前倾、肩松、双手回膝，抬眼羞涩笑。
    # 所有关係答复之前，无牵手/拥抱/画外玩家身体；短句沿130px框呈现；三答复前清除CG并恢复肖像。
    "她又看你一眼，河风将几绺发尾送到手背，她顺着理开，没有拿头发遮住刚说完的脸。"
    l_cl "我想听你进门时说一句话。"
    l_cl "也想在你还没开口时，先给你留一个位置。"
    l_you "连我卡在木钩上那次也想听？"
    l_cl "那次先摘袖子。我还没爱上木钩。"
    "你笑了一下，她也笑了，肩头终于放松。可你向平石伸手，她仍立刻看过去，以为你要把邀请收起来。"
    l_you "我拿水。"
    l_cl "知道了。水在右边。"
    "她把壶推近，自己也倒一点，抿了一口。再将杯子放下时，她的语速恢复得很平。"
    l_cl "现在我想听你的回答。你愿意是哪一种，就说哪一种。"
    scene bg river day with dissolve
    $ main_cg = None
    $ hide_speaker_portrait = False
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    menu:
        "我想和你成为恋人。":
            $ claude7_answer = "love"
            l_you "我想和你成为恋人。"
            "Claude望着你，像是还要将这句听一次。她没有问自己哪件事做得好，只把唇边那点没放出来的笑留住。"
        "我还需要一点时间。":
            $ claude7_answer = "wait"
            l_you "我还需要一点时间。今天不能答应恋爱。"
            "Claude把手放回自己的膝上。她看着你把这句说完，没将纸往前推，也没有先替你补一个以后。"
        "我想一直做你的朋友。":
            $ claude7_answer = "friend"
            l_you "我想一直做你的朋友。我不想与你恋爱。"
            "Claude安静了片刻，点了一下头。木夹仍在平石上，她没伸手抹去邀请末尾自己的名字。"
    $ claude7_answer_heard = True
    return

label claude07_scene5:
    $ chapter = "Claude 第七章 / 05 · 这一句已经听见"
    scene bg river day with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    if claude7_answer == "love":
        l_cl "我听见了。再看我一下。"
        "你抬头，她的目光已经等在那里。她坐得仍在厚垫上，膝边的手握了又松，没有越过来替你握住杯子。"
        l_you "刚才哪句没听清？"
        l_cl "都听清了。只是想再看看说这句话的人。"
        l_you "现在看清了？"
        l_cl "比你在门钩上挂着时清楚。"
        "她说完笑了，手指扣住自己袖口一点。你将杯子放回石面，空出的手落到两只座垫之间。"
        l_cl "能坐近一点吗？我想靠着你。"
        $ claude7_close_asked = True
        l_you "能。我也想。"
        $ claude7_close_agreed = True
        "你挪近薄垫，她也将厚垫向中间移一点。她自己理好裙边，先把食盒拿到外侧，才让肩头轻轻靠过来。"
        "两只垫子交界处留着一条缝，你的袖子贴到她袖边。她没有急着把整个身子压过去，只在靠稳后低头看了一眼。"
        l_you "这里又有折痕？"
        l_cl "有。衣袖的。可以留着。"
        "她说得很轻，指尖从自己的袖口松开，试着碰到你手旁。你转过手心，她停了一下，才将手放进去。"
        l_cl "这样可以？"
        l_you "可以。"
        "她的手有些凉，掌心却稳。你握住时，她拇指很轻地动了一次，没有再缩回去。"
        l_cl "今天一路上，我想过先牵手。"
        l_you "到了河边才想？"
        l_cl "买梨那会儿已经想过。手里有钱，怕一起掉。"
        l_you "你现在还在算能省几次手？"
        l_cl "没有。我就是想牵这只。"
        "她把最后半句说得比前面的梨更快一点，随即抬眼看你。你没有笑它，她的拇指便又轻轻碰了一下。"
        l_you "我也想靠近你。今天能说这句了。"
        l_cl "能。别只留给今天。"
        "你们坐了一会儿。她靠着你的肩，先看远处桥下的影子，随后将视线移回来，停在你手背上。"
        l_cl "我刚才写纸的时候，想给这句找一个很好听的开头。"
        l_you "找到了吗？"
        l_cl "没有。第一句太像我替人写的邀请函。"
        l_you "你现在这句很好听。"
        l_cl "现在这句是嫌它写得差。你夸早了。"
        "你被她接得笑起来，肩头跟着动。她没有离开，只把握着的手轻轻抬一下，让你别将她也带得摇晃。"
        l_cl "还有，我不想每次见你都端好一整盒。"
        l_you "今天已经差点洒了。"
        l_cl "嗯。以后也会。那时别让我先写说明。"
        "她把自己的水杯拿近，喝了一口才离开一点，给你留出够食盒的空间。靠过来没有让她忘掉自己带来的酸梨。"
        l_cl "现在我想吃。你先松一点。"
        l_you "刚刚牵到，就被梨分开？"
        l_cl "吃完再牵。梨放凉了，也该吃。"
        "她先松开指尖，自己的手仍在你掌边停了一下。随后拿过食盒，把盖子翻到一边，没把第一次握手压在盒底。"
    elif claude7_answer == "wait":
        l_cl "好。今天不答应恋爱，我听见了。"
        "她看向河面一会儿，将原先捏着的垫角展开。你坐在薄垫上，没因为她先说喜欢就挪过去。"
        l_you "我不想让你以为，我已经选好了只是不好意思。"
        l_cl "那就照你说的留着。你还没选恋爱。"
        "她拿起自己的杯子，喝了一口。杯底回到平石上，她又看看那张邀请，伸手松了一下木夹。"
        l_you "要拿回去？"
        l_cl "它是我给你的。想看看自己有没有写哪天必须回答。"
        l_you "没有。只有今天的见面。"
        l_cl "嗯。今天已经见到了。"
        "她将木夹重新夹在空白处，纸没有变成另一份待签的单子。你把自己那只杯子收近一点，给她的手留位置。"
        l_you "如果过一阵，我还是答不了呢？"
        l_cl "告诉我。我们再决定要不要继续等。"
        l_you "你可以先不等。"
        l_cl "可以。现在我想保留下一次见面的邀请。到那时也能重问。"
        $ claude7_wait_revisable = True
        "她把小钱袋放回袋内，像是终于不必用它占住自己的手。随后拿起食盒，试了试盖子是否够凉。"
        l_cl "我会想知道答案。不会让你每晚交一张今天多喜欢我几分。"
        l_you "我没有那张表。"
        l_cl "我也没有。买梨那点账已经够算了。"
        "她笑一下，笑意短些，却没有立刻把它收成客气的送别。你看着盒子问，她这份梨今天还想吃吗。"
        l_cl "想。我上午煮了那么久。"
        l_you "我也想一起吃。你愿意继续坐吗？"
        l_cl "愿意。先坐完这次，别一口气替后来全订下。"
        "你说好，她将两只小勺放到食盒边。两人的座垫仍各在原处，她把盒子放在能够一起够到的地方。"
        l_you "小说后面，你可以自己先读。"
        l_cl "我本来就可能先读完。凶手不必坐在最后一页等我们。"
        l_you "那下回我问你，别一下全告诉我。"
        l_cl "看你先问谁。你若先问锅，我就只答锅。"
        "你低头笑了笑，她拿自己的勺轻轻点了一下盒沿。两次声音，随后她认真地叫了你一声。"
        l_cl "今天这句，我没有收回。可是你也不用带回去继续替我答。"
        l_you "我知道是你喜欢我。我现在还需要时间。"
        l_cl "好。我们先吃自己选的梨。"
        "她没有递来牵手的邀请，也没拿两人刚一起煮东西当成已经答应。她坐稳厚垫，取下盒盖。"
    else:
        l_cl "好。朋友，不恋爱。我听见了。"
        "她看着那张浅色纸，手指停在木夹旁。过了一会儿，她将夹子取下来放入袋格，纸仍留在原处。"
        l_you "纸要还你吗？"
        l_cl "不用。今天是我想说，才给你的。"
        "你把纸边扶住，免得被风带走。她望了你一眼，自己从另一角压平，没有要你念一段理由。"
        l_cl "我会遗憾一小会儿。先让我喝口水。"
        "你说好。她拿杯子时动作比刚才慢一点，喝完先把壶盖扣好，再将杯子放稳。你没接过来替她忙。"
        l_cl "好了。还有一件我想问。"
        l_you "你说。"
        l_cl "这盒梨，你还愿意一起吃吗？是今天一起煮的。"
        l_you "愿意。你也想？"
        l_cl "想。只是我刚才忘了它在这里。"
        "她把食盒挪到中间，拿出两只勺。第一只递给你，第二只留在自己的手里，她不再预留一句恋人的称呼。"
        l_you "以后想推荐很坏的侦探书，我能来吗？"
        l_cl "能。先说你愿意推荐的是书，还是错答案。"
        l_you "可以一起。看错的那页附在后面。"
        l_cl "那我要先读完再告诉你。免得你说我只是随便猜。"
        $ claude7_friend_plan = True
        "她抿着的嘴角动了一点。风吹过来，她拿木夹压住食盒边的一张干纸，没有把它再夹回邀请上。"
        l_you "今天你想先一个人坐会儿也可以。"
        l_cl "现在不用。吃完以后，我想自己带书回去。"
        l_you "那我拿自己的垫子。"
        l_cl "嗯。水壶不用一起争。回来放到廊口就好。"
        "她说完将书袋收近一点，给食盒腾出地方。你们各拿起自己的勺子，勺尖在盒边轻轻碰了一下。"
        l_you "我刚才担心，吃梨会像装作那句没发生。"
        l_cl "它发生了。你答过了，我也听见了。梨只是还没吃。"
        l_you "那现在吃。"
        l_cl "等一下。让我先尝那块小的。"
        "她用自己的勺挖出靠盒角的一小块。梨已经凉下来，糖汁凝得更浓，她尝过，肩头慢慢松开。"
        l_you "够酸？"
        l_cl "比上午直接啃好多了。你不用为了今天，把它说成最甜的。"
        "你也取了一块，说还是有酸味。她点头，又拿一块给自己，没将你那格剩余的收走。"
    return

label claude07_scene6:
    $ chapter = "Claude 第七章 / 06 · 最后那块也要吃掉"
    scene bg river day with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "四点三十五分，食盒两格都开着。梨被煮得不太整齐，一块厚、一块薄，最下面还留着两条没切透的边。"
    l_you "它们没有按你说的，两个人分得一样。"
    l_cl "我说吃得完。没说做得一样。"
    "她用勺轻轻压了一块，浓汁从边上慢慢淌下。你捏着勺柄，先抬得太高，甜汁又沿原路落回盒内。"
    l_cl "低一点。你也想给它找第三个底？"
    l_you "给自己找。你上午已经示范过一次。"
    if claude7_snack_help == "tray":
        l_cl "上午你扶住纸托，梨没落到手上。现在不用扶自己的勺。"
        "她把盒子稍转向你，让你那格靠近。你低一点挖起梨，她看着汁没有继续跑，才拿自己的下一块。"
        l_you "这次多用的两只手，没白用。"
        l_cl "嗯。你没替我把那块纸也煮进去。"
    else:
        l_cl "上午你把平盘送来，这次把盒子放稳就好。"
        "你让盒底靠住平石较平的一处。她看清不晃了，才松开外侧，拿起自己的勺继续吃。"
        l_you "盘子在廊里歇着。"
        l_cl "它今天不用陪我们走回来。这个盒子还要洗。"
    "远处有个小孩追着掉落的叶子跑，经过凳子时停了一下，看看盒里的梨。Claude将盖子往自己这边收，免得勺柄伸到路上。"
    "小孩的家人叫他回去，他跑了两步又回头，问那是不是甜的。Claude看着勺里的一小块，认真答了酸的。"
    l_you "你至少可以加个带糖。"
    l_cl "他问甜不甜。以后想吃酸的，才知道来问。"
    "小孩去追另一片叶子，没有站在旁边要分一口。她收回视线，将那块梨放进口中，脸上那一点酸意仍藏不住。"
    l_you "你每吃一口都会这样。"
    l_cl "我还想吃下一口。别替我宣布不喜欢。"
    "你也再吃一块。这次稍薄，甜味更明显，你说这一块好，她把自己那格翻翻，也想找到一样薄的。"
    "勺碰到两条没切断的梨边，她抬起来，看见它们像挽着手，终于先笑了。"
    l_cl "刀没过去。它们自己留下来了。"
    l_you "你用哪只手分？"
    l_cl "勺子。先别又要借锯。"
    "她把两条梨边压开，自己留一条，另一条放回盒里，你再从那格取来。没有要把同一块分得像一张对账单。"
    if claude7_answer == "love":
        "食盒剩下一小块，她看向你。你说她想吃就吃，她拿起来尝，随后用干纸擦净指尖，手向你这边伸了一点。"
        l_cl "吃完了。刚才那只手，还给我吗？"
        l_you "给。"
        "你将手递过去，她握住，手臂轻轻靠着你。她低头确认食盒已经扣好，才把目光转回你的脸。"
        l_you "盒子是第五次确认？"
        l_cl "这是收东西。不要替我把牵手也数进去。"
        "你说不数。她停了一会儿，忽然用拇指轻轻碰过你手边一道折起的袖纹，又顺着放回去。"
        l_cl "其实我现在还想数。"
        l_you "数什么？"
        l_cl "你看过来几次。怕错过。"
        "你看向她，她这次没有赶快收回目光。蓝封书还在袋内，两人的手空着，没有一页正文需要急着翻。"
    elif claude7_answer == "wait":
        "食盒剩下一小块，她看向你。你说留给她，她自己取来吃了，随后合好盖子，把两只勺分别擦净。"
        l_cl "下回见面，不必先带答案才能进门。"
        l_you "但我会记得再说明自己的想法。"
        l_cl "我也是。要是我不想继续等，也会说。"
        "她把你那只干勺递回来，你接住，没有把这次递东西当成一次变得更亲密的暗号。"
        l_you "下回还能带这种梨？"
        l_cl "不一定。我可能已经吃够了。"
        l_you "那我到时再问。"
        l_cl "嗯。今天先把这只空盒带回去。"
        "她将盖子扣好，不给盒里留一块为了等你选择而不能吃完的点心。你挪开自己的杯子，让她将盒子放回袋外格。"
    else:
        "食盒剩下一小块，她看向你。你说留给她，她取来吃掉，没为了表示没事就再请你拿走整个盒子。"
        l_cl "以后那本很坏的书，带自己的来。"
        l_you "你这本不借？"
        l_cl "借之前我想先看完。这周不借。"
        l_you "好。我先去找一本能和它比坏的。"
        l_cl "别只看书名里有几个嫌疑人。里面的鞋也要看。"
        "你说记住了。她笑了一下，把两只勺擦好，你接过自己那只，另一只由她留在食盒侧边。"
        "你们坐在各自的垫子上。她看着河面那艘空船，先将一缕发尾绕到耳后，再把杯底那点水喝完。"
    $ claude7_snack_shared = True
    "四点四十八分，风把邀请纸又翻起一点。Claude伸手扶住木夹，随后看向你，等你自己将纸拿回。"
    l_cl "你想留下吗？"
    l_you "想。今天那句在纸上没有写全，我也听到了。"
    l_cl "嗯。纸上的名字不用补第二个。"
    if claude7_previous_pause == "marker":
        "你将浅色纸折好，只留她自己的落款。小说的原位置签留在第二章末，停读空签仍在另一格。"
    elif claude7_previous_pause == "cup":
        "你将浅色纸折好，只留她自己的落款。小说的原位置签留在第二章末，宽口杯仍摆在石面上。"
    else:
        "你将浅色纸折好，只留她自己的落款。她收稳蓝封小说，手没有把第二章末的位置签抽出来替你压纸。"
    $ claude7_paper_kept = True
    "你们各自喝完杯中的水，她先合上自己的水壶。你拿起那只宽些的杯子，将杯底残留的水倒在石边。"
    l_you "这杯今天没让谁停在半句。"
    l_cl "你最后那句也说完了。"
    "她把小木夹收回袋格，手沿着蓝封书边轻轻碰一下，没有给原猜添上因为今天就算赢的字。"
    l_you "第三章还是没读。"
    l_cl "今天还有我想说的话。后面我自己会翻。"
    "她将袋口扣好。厚垫从凳上抬起时，比铺下去软了一点，边角留下她今天坐过的浅痕。"
    return

label claude07_scene7:
    $ chapter = "Claude 第七章 / 07 · 今天带回去的是今天"
    scene bg river day with dissolve
    show sprite claude as claude at sprite_breathe(0.65) with dissolve
    "四点五十五分，两只座垫都收起。Claude抱着厚的，食盒在布袋外格，蓝封书仍由她自己带。你拿薄垫和水壶。"
    "长凳上只剩干布擦过的一道浅色，你看了看，确认没有把纸和勺留在缝中。她走出几步，停在石路较窄的那一段。"
    if claude7_answer == "love":
        "她回头看你，空着的手向后伸一点。你先将水壶换到拿薄垫那边，告诉她这次拿稳了，才接住。"
        l_you "买梨时怕掉钱，现在怕掉壶？"
        l_cl "我刚才是等你换手。你别让壶占到五点。"
        "你们沿窄路往回走，手握得松些。遇到湿石面，她自己绕过去，走稳了才又靠近半步。"
        l_cl "刚才我说别只留给今天。还有半句。"
        l_you "我在听。"
        l_cl "明天见到我，你可以先叫我的名字。"
        l_you "Claude。"
        "她抬眼，笑意一下出现在眼角。你又看见她抱着那只厚垫，手臂压住一边，没让它从怀里滑下去。"
        l_cl "现在这一声也可以。别再让我重新写邀请。"
        "你说好。她走到路稍宽的地方，轻轻晃了一下两人的手，随后停住，像是先看看这个动作自己喜不喜欢。"
        l_you "要再试一次？"
        l_cl "等回去放下东西。现在有点重。"
    elif claude7_answer == "wait":
        "她回头问你，水壶是否要换手。你说拿得稳，她便走到较干的石面等你过来，没有伸手把两人的距离改成答复。"
        l_you "这次五点回来，还来得及。"
        l_cl "嗯。明早我先看那块门牌。下午还没排。"
        l_you "你可以先排自己想做的。"
        l_cl "想去书店看看。那本同系列的封面很难看。"
        l_you "难看也想看？"
        l_cl "我想知道它能不能再让门房挂一只更大的锅。"
        "你笑着说那就看，她也笑一下，将书袋往肩内侧挪好。她的下一本书没有被今天尚未决定的关系拦在柜台。"
        l_cl "如果看到好玩的，我下回讲。不是每天一张进度。"
        l_you "下回当面听。"
        "她点头，先绕开石边的水洼。你走到她身侧，两个人各拿着自己的东西，步子不必一直齐成一条线。"
    else:
        "她回头看见你拿稳了水壶，说她想从书店那边绕一小段。你问要不要一起，她摇头，语气很平。"
        l_cl "这一段想自己走。五点前把你的垫子放回廊里就好。"
        l_you "那你那只放哪儿？"
        l_cl "我抱着。你别连厚垫都替我送回去。"
        "你说好，将薄垫翻到干净的一面。她看你手里的水壶，想了想，补一句壶放台下即可，不必为了等她回来继续坐。"
        l_you "下次推荐那本书的时候，我会先问你有没有空。"
        l_cl "嗯。别把书名直接当预约。"
        l_you "嫌疑人太多，占不下？"
        l_cl "凳子只坐人。你先把帽子留在书里。"
        "你们在分路处停了片刻，她自己把书袋往肩内侧挪好。她向你点头，转去书店那条路，没有回头索要另一种回答。"
        "你沿廊口的路走，把薄垫和水壶送回原处。浅色纸留在你的口袋里，今天的朋友答复也已说完。"
    "五点整，今天那场见面已经结束。没有公开听书，也没有临时给小说补一位已揭出的凶手。"
    if claude7_answer == "love":
        "回到廊口，她放下厚垫和书袋，先从你手中接过空水壶。再看向你时，自己的手终于空了。"
        l_cl "这次不用换手了。"
        "你将手递过去，她握住，肩头轻轻贴近一下。她的小说放在自己的那一格，没有替今天这句把最后一页翻开。"
    elif claude7_answer == "wait":
        "回到廊口，她放下厚垫，将自己的小说收入柜内的私人一格。你将壶摆到台下，她没另取纸来约一个必须答复的日子。"
        l_cl "今天见到了。下回想见面，再当面问。"
        "你说好。她自己打开食盒去清洗，梨汁已经吃完，后面的书也还由她自己读。"
    else:
        "你将水壶放在台下，照她说的位置摆好。廊里的公用夹保持合着，她自己的厚垫和小说，会由她回来后安放。"
        "你没留下替她表达已经没事的便条。口袋里这张纸，是她今天当面给的邀请，也已经得到你的回答。"
    $ claude7_private_time_kept = True
    $ claude7_day_closed = True
    # 章八尚未撰写：return后仍属partial，不调用完成API。
    return
